usage_bar() {
  local pct="$1" w="${2:-10}" filled i bar="[" color=""
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  filled=$(( pct * w / 100 ))
  if (( pct >= 80 )); then
    color="${C_RED}"
  elif (( pct >= 50 )); then
    color="${C_YELLOW}"
  else
    color="${C_GREEN}"
  fi
  for ((i = 0; i < w; i++)); do
    if (( i < filled )); then 
      bar+="${color}#${C_RESET}"
    else 
      bar+=" "
    fi
  done
  bar+="]"
  printf '%s' "$bar"
}

bucket_cell() {
  local q="$1" u="$2" r="$3" mode="${4:-wide}" bar_w="${5:-}"
  is_int "$q" || q=-1
  is_int "$u" || u=0
  is_int "$r" || r=0
  if (( q <= 0 )); then
    return
  fi
  if [[ "$mode" == "compact" ]]; then
    is_int "$bar_w" || bar_w=6
    if (( r >= 2000000000 )); then
      local bar
      bar=$(usage_bar 100 "$bar_w")
      printf "%s 100%% %s000/%-3d%s ${C_RED}REVOKD${C_RESET}" \
        "$bar" "${C_RED}" "$q" "${C_RESET}"
      return
    fi
    local now pct left bar left_color cd_str
    now=$(date +%s)
    pct=0
    (( q > 0 )) && pct=$(( u * 100 / q ))
    (( pct > 100 )) && pct=100
    left=$(( q - u ))
    (( left < 0 )) && left=0

    bar=$(usage_bar "$pct" "$bar_w")

    left_color="${C_GREEN}"
    (( left < 20 )) && left_color="${C_RED}" || { (( left < 50 )) && left_color="${C_YELLOW}"; }

    if (( r <= now || u == 0 )); then
      cd_str="${C_BRIGHT_GREEN} READY${C_RESET}"
    else
      cd_str="${C_YELLOW}$(fmt_time "$(( r - now ))" compact)${C_RESET}"
    fi

    printf "%s %03d%% %s%03d/%-3d%s %s" \
      "$bar" "$pct" "$left_color" "$left" "$q" "${C_RESET}" "$cd_str"
  else
    is_int "$bar_w" || bar_w=18
    if (( r >= 2000000000 )); then
      local bar
      bar=$(usage_bar 100 "$bar_w")
      printf "%s 100%%  %s000 / %-3d%s  ${C_RED}REVOKED${C_RESET}" \
        "$bar" "${C_RED}" "$q" "${C_RESET}"
      return
    fi
    local now pct left bar left_color cd_str
    now=$(date +%s)
    pct=0
    (( q > 0 )) && pct=$(( u * 100 / q ))
    (( pct > 100 )) && pct=100
    left=$(( q - u ))
    (( left < 0 )) && left=0

    bar=$(usage_bar "$pct" "$bar_w")

    left_color="${C_GREEN}"
    (( left < 20 )) && left_color="${C_RED}" || { (( left < 50 )) && left_color="${C_YELLOW}"; }

    if (( r <= now || u == 0 )); then
      cd_str="${C_BRIGHT_GREEN} READY ${C_RESET}"
    else
      cd_str="${C_YELLOW}$(fmt_time "$(( r - now ))" std)${C_RESET}"
    fi

    printf "%s %03d%%  %s%03d / %-3d%s  %s" \
      "$bar" "$pct" "$left_color" "$left" "$q" "${C_RESET}" "$cd_str"
  fi
}

cmd_whoami() {
  local scope="all" short=0
  for arg in "$@"; do
    case "$arg" in
      --cli)
        scope="cli"
        ;;
      --acp)
        scope="acp"
        ;;
      -s|--short)
        short=1
        ;;
      *)
        echo -e "${C_RED}Error: unknown option '$arg' for whoami. Valid options: --cli, --acp, -s, --short${C_RESET}" >&2
        return 1
        ;;
    esac
  done

  sync_t3_profiles 2>/dev/null || true

  local cli_name acp_name
  cli_name=$(find_active_AUTH 2>/dev/null) || cli_name=""
  acp_name=$(find_active_acp_AUTH 2>/dev/null) || acp_name=""

  local cli_ref acp_ref
  cli_ref=$(get_refresh_AUTH "$TARGET_AUTH" 2>/dev/null) || cli_ref=""
  acp_ref=$(get_refresh_AUTH "$TARGET_ACP_AUTH" 2>/dev/null) || acp_ref=""

  if (( short == 1 )); then
    if [[ "$scope" == "cli" ]]; then
      if [[ -n "$cli_name" ]]; then
        echo "$cli_name"
        return 0
      fi
      return 1
    elif [[ "$scope" == "acp" ]]; then
      if [[ -n "$acp_name" ]]; then
        echo "$acp_name"
        return 0
      fi
      return 1
    else
      if [[ -n "$cli_name" && "$cli_name" == "$acp_name" ]]; then
        echo "$cli_name"
        return 0
      elif [[ -n "$cli_name" || -n "$acp_name" ]]; then
        echo "cli:${cli_name:-none} acp:${acp_name:-none}"
        return 0
      fi
      return 1
    fi
  fi

  if [[ "$scope" == "cli" ]]; then
    if [[ -n "$cli_name" ]]; then
      echo -e "${C_GREEN}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_WHITE}${cli_name}${C_RESET}"
    elif [[ -n "$cli_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name>)${C_RESET}"
    else
      echo -e "${C_DIM}● CLI profile: none configured${C_RESET}"
    fi
    return 0
  elif [[ "$scope" == "acp" ]]; then
    if [[ -n "$acp_name" ]]; then
      echo -e "${C_GREEN}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_WHITE}${acp_name}${C_RESET}"
    elif [[ -n "$acp_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name> --acp)${C_RESET}"
    else
      echo -e "${C_DIM}● ACP profile: none configured${C_RESET}"
    fi
    return 0
  fi

  if [[ -n "$cli_name" && "$cli_name" == "$acp_name" ]]; then
    echo -e "${C_GREEN}● Active profile:${C_RESET} ${C_BOLD}${C_WHITE}${cli_name}${C_RESET} ${C_DIM}(CLI & ACP synced)${C_RESET}"
  elif [[ -n "$cli_name" ]]; then
    echo -e "${C_GREEN}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_WHITE}${cli_name}${C_RESET}"
    if [[ -n "$acp_name" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}${acp_name}${C_RESET} ${C_DIM}(desynced — run 'agyy swap ${cli_name}' to align)${C_RESET}"
    elif [[ -n "$acp_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name> --acp)${C_RESET}"
    else
      echo -e "${C_DIM}● ACP profile: none configured${C_RESET}"
    fi
  elif [[ -n "$acp_name" ]]; then
    if [[ -n "$cli_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name>)${C_RESET}"
    else
      echo -e "${C_DIM}● CLI profile: none configured${C_RESET}"
    fi
    echo -e "${C_GREEN}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_WHITE}${acp_name}${C_RESET}"
  elif [[ -n "$cli_ref" || -n "$acp_ref" ]]; then
    if [[ -n "$cli_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name>)${C_RESET}"
    fi
    if [[ -n "$acp_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name> --acp)${C_RESET}"
    fi
  else
    echo -e "${C_YELLOW}No active profile configured. Run 'agyy' to log in.${C_RESET}"
  fi
}

revoke_AUTH_token() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  local ref_token acc_token
  ref_token=$(get_refresh_AUTH "$f") || ref_token=""
  acc_token=$(get_access_AUTH "$f") || acc_token=""

  local target_token="${ref_token:-$acc_token}"
  if [[ -n "$target_token" ]]; then
    echo -e "${C_DIM}Revoking token on Google servers...${C_RESET}"
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" -X POST -d "token=${target_token}" https://oauth2.googleapis.com/revoke 2>/dev/null || echo "000")
    if [[ "$http_code" == "200" ]]; then
      echo -e "${C_GREEN}✔ Token revoked on Google servers.${C_RESET}"
    else
      echo -e "${C_YELLOW}ℹ Google Revoke response: HTTP ${http_code} (token may already be inactive).${C_RESET}"
    fi
  fi
}

cmd_delete() {
  local target_name=""
  local force=0
  local do_revoke=0
  local specified_revoke_flag=0

  for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--force" || "$arg" == "-y" ]]; then
      force=1
    elif [[ "$arg" == "-r" || "$arg" == "--revoke" ]]; then
      do_revoke=1
      specified_revoke_flag=1
    elif [[ -z "$target_name" ]]; then
      target_name="$arg"
    fi
  done

  if [[ -z "$target_name" ]]; then
    shopt -s nullglob
    local auth_files=("$AUTH_DIR"/antigravity-oauth-token-*)
    shopt -u nullglob
    if (( ${#auth_files[@]} == 0 )); then
      echo -e "${C_RED}No auth profiles found in $AUTH_DIR.${C_RESET}" >&2
      return 1
    fi

    echo -e "${C_BOLD}Saved profiles:${C_RESET}"
    for f in "${auth_files[@]}"; do
      local n="${f##*antigravity-oauth-token-}"
      echo -e "  - ${C_CYAN}${n}${C_RESET}"
    done
    echo
    read -p "Profile name to delete: " -r target_name || return 1
    target_name=$(printf '%s' "$target_name" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  fi

  if [[ -z "$target_name" ]]; then
    echo -e "${C_RED}Error: no profile name specified.${C_RESET}" >&2
    return 1
  fi

  local target_file="$AUTH_DIR/antigravity-oauth-token-$target_name"
  local active_name
  active_name=$(find_active_AUTH) || active_name=""
  local is_active=0
  [[ "$target_name" == "$active_name" ]] && is_active=1

  if (( is_active == 1 && force == 0 )); then
    local confirm
    echo -e "${C_YELLOW}⚠ Warning: '${C_BOLD}${target_name}${C_RESET}${C_YELLOW}' is the active profile.${C_RESET}"
    read -p "Delete and auto-switch to next available profile? (y/N): " -r confirm || confirm="n"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo -e "${C_DIM}Deletion cancelled.${C_RESET}"
      return 0
    fi
  fi

  if (( specified_revoke_flag == 0 && force == 0 )); then
    local ask_revoke
    read -p "Also permanently revoke token on Google servers? (y/N): " -r ask_revoke || ask_revoke="n"
    if [[ "$ask_revoke" =~ ^[Yy]$ ]]; then
      do_revoke=1
    fi
  fi

  if (( do_revoke == 1 )) && [[ -f "$target_file" ]]; then
    revoke_AUTH_token "$target_file"
  fi

  local removed=0
  if [[ -f "$target_file" ]]; then
    rm -f "$target_file"
    removed=1
  fi

  if [[ -f "$USAGE_FILE" ]]; then
    local esc tmp
    esc=$(re_escape "$target_name")
    tmp=$(mktemp)
    grep -v -E "^${esc}${DEL}" "$USAGE_FILE" > "$tmp" || true
    mv "$tmp" "$USAGE_FILE"
  fi

  if (( removed == 1 )); then
    echo -e "${C_GREEN}✔ Deleted profile '${C_BOLD}${target_name}${C_RESET}${C_GREEN}'.${C_RESET}"
    if (( is_active == 1 )); then
      echo -e "${C_DIM}Switching to next available profile...${C_RESET}"
      prepare_AUTH "" || true
    fi
  else
    echo -e "${C_YELLOW}Profile '${target_name}' not found in $AUTH_DIR.${C_RESET}"
  fi
}

cmd_status() {
  sync_t3_profiles 2>/dev/null || true

  local filter_model=""
  local filter_auth=""

  for arg in "$@"; do
    case "$arg" in
      --cli|--acp)
        echo -e "${C_RED}Error: 'agyy status' does not take '--cli' or '--acp' flags. Use 'agyy whoami [--cli|--acp]' to inspect active scopes.${C_RESET}" >&2
        return 1
        ;;
      gemini|Gemini|claude|Claude)
        local lower="${arg,,}"
        [[ "$lower" == "gemini" ]] && filter_model="Gemini"
        [[ "$lower" == "claude" ]] && filter_model="Claude"
        ;;
      -*)
        echo -e "${C_RED}Error: unknown option '$arg' for status. Valid syntax: agyy status [name] [model]${C_RESET}" >&2
        return 1
        ;;
      *)
        if [[ -z "$filter_auth" ]]; then
          filter_auth="$arg"
        fi
        ;;
    esac
  done

  local active_name acp_name acp_status
  active_name=$(find_active_AUTH 2>/dev/null) || active_name=""
  acp_name=$(find_active_acp_AUTH 2>/dev/null) || acp_name=""
  if [[ -n "$active_name" && "$active_name" == "$acp_name" ]]; then
    acp_status="${C_GREEN}synced${C_RESET}"
  elif [[ -n "$acp_name" ]]; then
    acp_status="${C_YELLOW}${acp_name}${C_RESET}"
  elif [[ -f "$TARGET_ACP_AUTH" ]]; then
    acp_status="${C_YELLOW}untracked${C_RESET}"
  else
    acp_status="${C_DIM}none${C_RESET}"
  fi

  local yolo_status continue_status
  [[ -f "$YOLO_FILE" ]] && yolo_status="${C_GREEN}ON${C_RESET}" || yolo_status="${C_YELLOW}OFF${C_RESET}"
  [[ -f "$CONTINUE_FILE" ]] && continue_status="${C_GREEN}ON${C_RESET}" || continue_status="${C_YELLOW}OFF${C_RESET}"

  local total_auths=0
  [[ -f "$USAGE_FILE" ]] && total_auths=$(grep -c . "$USAGE_FILE" 2>/dev/null || echo 0)

  local max_name_w=12
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    read_fields "$line"
    local n="${SPLIT[0]}"
    local l=${#n}
    if [[ "$n" == "$active_name" && "$active_name" == "$acp_name" ]]; then
      l=$(( l + 9 ))
    elif [[ "$n" == "$active_name" || "$n" == "$acp_name" ]]; then
      l=$(( l + 6 ))
    fi
    (( l > max_name_w )) && max_name_w=$l
  done < "$USAGE_FILE"

  local line name tmp
  tmp=$(mktemp)
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    read_fields "$line"
    name="${SPLIT[0]}"
    AUTH_stat

    local key=0
    # Tier 0: Active CLI profile pinned at row 1
    if [[ -n "$active_name" && "$name" == "$active_name" ]]; then
      key=0
    # Tier 0.5: Active ACP profile (if distinct) pinned at row 2
    elif [[ -n "$acp_name" && "$name" == "$acp_name" ]]; then
      key=1
    elif [[ -n "$filter_model" ]]; then
      # Model-filtered sorting
      local m_blk=0 m_left=0 m_rev=0 m_eff=0 m_q=100
      if [[ "$filter_model" == "Gemini" ]]; then
        m_blk=$M_BLOCKED_G; m_left=$M_LEFT_G
        (( G5_REVOKED == 1 || GW_REVOKED == 1 )) && m_rev=1
        m_eff=$(( G5_EFF > GW_EFF ? G5_EFF : GW_EFF ))
        (( GW_Q > 0 )) && m_q=$GW_Q
      else
        m_blk=$M_BLOCKED_C; m_left=$M_LEFT_C
        (( C5_REVOKED == 1 || CW_REVOKED == 1 )) && m_rev=1
        m_eff=$(( C5_EFF > CW_EFF ? C5_EFF : CW_EFF ))
        (( CW_Q > 0 )) && m_q=$CW_Q
      fi
      if (( m_rev == 1 )); then
        key=9999999999
      elif (( m_blk == 1 )); then
        key=$(( 3000000000 + m_left ))
      else
        local pct=$(( m_eff * 100 / m_q ))
        key=$(( 100000000 + pct * 1000 ))
      fi
    else
      # General sorting (all models):
      local is_revoked=0
      (( G5_REVOKED == 1 || GW_REVOKED == 1 || C5_REVOKED == 1 || CW_REVOKED == 1 )) && is_revoked=1

      if (( is_revoked == 1 )); then
        key=9999999999
      elif (( M_BLOCKED_G == 1 && M_BLOCKED_C == 1 )); then
        # Tier 3: Both blocked -> sort ascending by earliest recovery
        local earliest=$M_LEFT_G
        (( M_LEFT_C < earliest )) && earliest=$M_LEFT_C
        key=$(( 4000000000 + earliest ))
      elif (( M_BLOCKED_G == 1 || M_BLOCKED_C == 1 )); then
        # Tier 2: 1 model ready, 1 blocked -> sort ascending by soonest recovery of blocked model
        local cd=$M_LEFT_G
        (( M_BLOCKED_C == 1 )) && cd=$M_LEFT_C
        key=$(( 2000000000 + cd ))
      else
        # Tier 1: Both models ready -> sort ascending by lowest usage (freshest first)
        local u_g=$(( G5_EFF > GW_EFF ? G5_EFF : GW_EFF ))
        local u_c=$(( C5_EFF > CW_EFF ? C5_EFF : CW_EFF ))
        local max_pct=$(( u_g > u_c ? u_g : u_c ))
        local avg_pct=$(( (u_g + u_c) / 2 ))
        key=$(( 100000000 + max_pct * 1000 + avg_pct ))
      fi
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$key" "$name" \
      "${SPLIT[1]:--1}" "${SPLIT[2]:-0}" "${SPLIT[3]:-0}" \
      "${SPLIT[4]:--1}" "${SPLIT[5]:-0}" "${SPLIT[6]:-0}" \
      "${SPLIT[7]:--1}" "${SPLIT[8]:-0}" "${SPLIT[9]:-0}" \
      "${SPLIT[10]:--1}" "${SPLIT[11]:-0}" "${SPLIT[12]:-0}" >> "$tmp"
  done < "$USAGE_FILE"

  if [[ ! -s "$tmp" ]]; then
    echo -e "  ${C_RED}No auths detected in $AUTH_DIR${C_RESET}"
    rm -f "$tmp"
    return 0
  fi

  local header_active=""
  if [[ -n "$active_name" && "$active_name" == "$acp_name" ]]; then
    header_active="Active: ${C_BOLD}${C_WHITE}${active_name}${C_RESET} ${C_DIM}|${C_RESET} ACP: ${acp_status}"
  else
    local c_disp="${active_name:-none}"
    local a_disp="${acp_name:-none}"
    header_active="CLI: ${C_BOLD}${C_WHITE}${c_disp}${C_RESET} ${C_DIM}|${C_RESET} ACP: ${C_BOLD}${C_YELLOW}${a_disp}${C_RESET}"
  fi

  echo -e "  ${C_BOLD}${C_CYAN}Antigravity Auth Pool${C_RESET} ${C_DIM}|${C_RESET} ${header_active} ${C_DIM}|${C_RESET} YOLO: ${yolo_status} ${C_DIM}|${C_RESET} CONT: ${continue_status} ${C_DIM}|${C_RESET} Profiles: ${C_BOLD}${total_auths}${C_RESET}\n"

  local term_cols="${AGY_COLS:-${COLUMNS:-}}"
  if [[ -z "$term_cols" ]]; then
    term_cols=$(tput cols 2>/dev/null || true)
  fi
  is_int "$term_cols" || term_cols=120

  local mode="compact" auth_w=$(( max_name_w + 1 )) show_5h=1 bar_w=6 col_w=28 div_w=80 divider
  if (( term_cols >= 115 )); then
    mode="wide"
    (( auth_w < 16 )) && auth_w=16
    local overhead=$(( 4 + auth_w + 1 + 8 + 1 + 4 )) # marker(4) + auth_w + space(1) + model(8) + space(1) + divider(4)
    local avail=$(( (term_cols - overhead) / 2 ))
    bar_w=$(( avail - 27 ))
    (( bar_w > 26 )) && bar_w=26
    (( bar_w < 10 )) && bar_w=10
    col_w=$(( bar_w + 27 ))
    div_w=$(( overhead + col_w * 2 ))
  elif (( term_cols >= 75 )); then
    mode="compact"
    (( auth_w < 10 )) && auth_w=10
    local overhead=$(( 3 + auth_w + 1 + 6 + 1 + 3 )) # marker(3) + auth_w + space(1) + model(6) + space(1) + divider(3)
    local avail=$(( (term_cols - overhead) / 2 ))
    bar_w=$(( avail - 22 ))
    (( bar_w > 16 )) && bar_w=16
    (( bar_w < 5 )) && bar_w=5
    col_w=$(( bar_w + 22 ))
    div_w=$(( overhead + col_w * 2 ))
  else
    # Sub-75 column terminals: show primary weekly window only to prevent wrap
    mode="compact"
    show_5h=0
    (( auth_w < 10 )) && auth_w=10
    local overhead=$(( 3 + auth_w + 1 + 6 + 1 )) # marker(3) + auth_w + space(1) + model(6) + space(1)
    local avail=$(( term_cols - overhead ))
    bar_w=$(( avail - 22 ))
    (( bar_w > 14 )) && bar_w=14
    (( bar_w < 4 )) && bar_w=4
    col_w=$(( bar_w + 22 ))
    div_w=$(( overhead + col_w ))
  fi

  divider=$(printf '%*s' "$div_w" '' | tr ' ' '-')
  local first=1
  if [[ "$mode" == "compact" ]]; then
    if (( show_5h == 1 )); then
      printf " %-1s %-*s %-6s %-*s | %-*s${C_RESET}\n" "" "$auth_w" "AUTH" "MODEL" "$col_w" "WEEKLY WINDOW" "$col_w" "5-HOUR WINDOW"
    else
      printf " %-1s %-*s %-6s %-*s${C_RESET}\n" "" "$auth_w" "AUTH" "MODEL" "$col_w" "WEEKLY WINDOW"
    fi
    echo -e " ${C_DIM}${divider}${C_RESET}"
  else
    printf "  %-2s %-*s %-8s %-*s  | %-*s${C_RESET}\n" "" "$auth_w" "AUTH" "MODEL" "$col_w" "WEEKLY WINDOW" "$col_w" "5-HOUR WINDOW"
    echo -e "  ${C_DIM}${divider}${C_RESET}"
  fi

  sort -k1,1n -k2,2 "$tmp" | while IFS=$'\t' read -r _ name qG5 uG5 rG5 qGW uGW rGW qC5 uC5 rC5 qCW uCW rCW; do
    if [[ -n "$filter_auth" && "$name" != "$filter_auth" ]]; then
      continue
    fi

    if (( first == 0 )); then
      echo
    else
      first=0
    fi

    local marker=" "
    local raw_text="$name"
    local name_display="${C_BOLD}${C_WHITE}${name}${C_RESET}"

    if [[ -n "$active_name" && "$active_name" == "$acp_name" && "$name" == "$active_name" ]]; then
      marker="${C_BRIGHT_GREEN}●${C_RESET}"
      raw_text="${name} (active)"
      name_display="${C_BOLD}${C_BRIGHT_GREEN}${name} (active)${C_RESET}"
    elif [[ "$name" == "$active_name" ]]; then
      marker="${C_GREEN}●${C_RESET}"
      raw_text="${name} (cli)"
      name_display="${C_BOLD}${C_GREEN}${name} (cli)${C_RESET}"
    elif [[ "$name" == "$acp_name" ]]; then
      marker="${C_YELLOW}◆${C_RESET}"
      raw_text="${name} (acp)"
      name_display="${C_BOLD}${C_YELLOW}${name} (acp)${C_RESET}"
    fi

    local pad_len=$(( auth_w - ${#raw_text} ))
    (( pad_len < 1 )) && pad_len=1
    local pad
    pad=$(printf '%*s' "$pad_len" "")

    local cell_g5 cell_gw cell_c5 cell_cw
    cell_g5=$(bucket_cell "$qG5" "$uG5" "$rG5" "$mode" "$bar_w")
    cell_gw=$(bucket_cell "$qGW" "$uGW" "$rGW" "$mode" "$bar_w")
    cell_c5=$(bucket_cell "$qC5" "$uC5" "$rC5" "$mode" "$bar_w")
    cell_cw=$(bucket_cell "$qCW" "$uCW" "$rCW" "$mode" "$bar_w")

    if [[ "$mode" == "compact" ]]; then
      local g5_disp="" c5_disp=""
      if (( show_5h == 1 )); then
        [[ -n "$cell_g5" ]] && g5_disp=" | ${cell_g5}"
        [[ -n "$cell_c5" ]] && c5_disp=" | ${cell_c5}"
      fi

      if [[ -z "$filter_model" || "$filter_model" == "Gemini" ]]; then
        printf " %s %s%s %-6s %s%s\n" \
          "${marker}" "${name_display}" "${pad}" \
          "Gemini" "${cell_gw}" "${g5_disp}"
      fi
      if [[ -z "$filter_model" || "$filter_model" == "Claude" ]]; then
        if [[ "$filter_model" == "Claude" ]]; then
          printf " %s %s%s %-6s %s%s\n" \
            "${marker}" "${name_display}" "${pad}" \
            "Claude" "${cell_cw}" "${c5_disp}"
        else
          printf "   %-*s %-6s %s%s\n" \
            "$auth_w" "" \
            "Claude" "${cell_cw}" "${c5_disp}"
        fi
      fi
    else
      local g5_disp_w="" c5_disp_w=""
      [[ -n "$cell_g5" ]] && g5_disp_w="  | ${cell_g5}"
      [[ -n "$cell_c5" ]] && c5_disp_w="  | ${cell_c5}"

      if [[ -z "$filter_model" || "$filter_model" == "Gemini" ]]; then
        printf "  %s %s%s %-8s %s%s\n" \
          "${marker}" "${name_display}" "${pad}" \
          "Gemini" "${cell_gw}" "${g5_disp_w}"
      fi
      if [[ -z "$filter_model" || "$filter_model" == "Claude" ]]; then
        if [[ "$filter_model" == "Claude" ]]; then
          printf "  %s %s%s %-8s %s%s\n" \
            "${marker}" "${name_display}" "${pad}" \
            "Claude" "${cell_cw}" "${c5_disp_w}"
        else
          printf "    %-*s %-8s %s%s\n" \
            "$auth_w" "" \
            "Claude" "${cell_cw}" "${c5_disp_w}"
        fi
      fi
    fi
  done
  rm -f "$tmp"
}

pick_AUTH() {
  local target_model="${1:-}"
  local preferred_profile="${2:-}"
  local line found=0
  best_name=""; best_eff=999999; best_time=999999999; best_u=999999
  local pref_found=0 pref_name=""
  if [[ ! -s "$USAGE_FILE" ]]; then
    echo -e "${C_RED}No auths available.${C_RESET}" >&2
    return 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    read_fields "$line"
    AUTH_stat
    local healthy=0 left=0 eff=0 u=0
    if [[ "$target_model" == "Gemini" ]]; then
      healthy=$M_HEALTH_G
      left=$M_LEFT_G
      eff=$(( G5_EFF > GW_EFF ? G5_EFF : GW_EFF ))
      u=$(( G5_U + GW_U ))
    elif [[ "$target_model" == "Claude" ]]; then
      healthy=$M_HEALTH_C
      left=$M_LEFT_C
      eff=$(( C5_EFF > CW_EFF ? C5_EFF : CW_EFF ))
      u=$(( C5_U + CW_U ))
    else
      (( M_HEALTH_G == 1 && M_HEALTH_C == 1 )) && healthy=1
      left=$M_LEFT_G
      (( M_LEFT_C > left )) && left=$M_LEFT_C
      eff=$M_EFF_TOTAL
      u=$M_U_TOTAL
    fi

    if [[ -n "$preferred_profile" && "${SPLIT[0]}" == "$preferred_profile" && $healthy -eq 1 ]]; then
      pref_found=1
      pref_name="${SPLIT[0]}"
    fi

    local is_better=0
    if (( healthy == 1 && found == 0 )); then
      is_better=1
    elif (( healthy == 1 )); then
      if (( eff < best_eff )); then
        is_better=1
      elif (( eff == best_eff )); then
        if (( u < best_u )); then
          is_better=1
        fi
      fi
    elif (( found == 0 )); then
      if (( left < best_time )); then
        is_better=1
      fi
    fi

    if (( is_better == 1 )); then
      best_name="${SPLIT[0]}"; best_eff=$eff; best_time=$left; found=1; best_u=$u
    fi
  done < "$USAGE_FILE"
  if (( pref_found == 1 )); then
    best_name="$pref_name"
    found=1
  fi
  if (( found == 0 )); then
    echo -e "${C_RED}No suitable auth found.${C_RESET}" >&2
    return 1
  fi
  return 0
}

match_profile_by_ref() {
  local target_ref="$1"
  [[ -n "$target_ref" ]] || return 1
  local f name
  shopt -s nullglob
  for f in "$AUTH_DIR"/antigravity-oauth-token-*; do
    local f_ref
    f_ref=$(get_refresh_AUTH "$f") || f_ref=""
    if [[ "$target_ref" == "$f_ref" ]]; then
      name=${f#"$AUTH_DIR"/"antigravity-oauth-token-"}
      shopt -u nullglob
      echo "$name"
      return 0
    fi
  done
  shopt -u nullglob
  return 1
}

find_active_AUTH() {
  [[ -f "$TARGET_AUTH" ]] || return 1
  local target_ref
  target_ref=$(get_refresh_AUTH "$TARGET_AUTH") || target_ref=""
  match_profile_by_ref "$target_ref"
}

find_active_acp_AUTH() {
  local target_ref=""
  if [[ -f "$TARGET_ACP_AUTH" ]]; then
    target_ref=$(get_refresh_AUTH "$TARGET_ACP_AUTH") || target_ref=""
  fi
  if [[ -z "$target_ref" ]]; then
    local t3_base="$T3_USERDATA_DIR/providers/antigravity"
    if [[ -d "$t3_base" ]]; then
      for t3_inst in "$t3_base"/*; do
        if [[ -f "$t3_inst/antigravity-acp/acp_token.json" ]]; then
          target_ref=$(get_refresh_AUTH "$t3_inst/antigravity-acp/acp_token.json" 2>/dev/null || true)
          [[ -n "$target_ref" ]] && break
        fi
      done
    fi
  fi
  [[ -n "$target_ref" ]] || return 1
  match_profile_by_ref "$target_ref"
}

swap_AUTH() {
  local target_scope="all"
  local desired_auth=""
  local target_model=""

  for arg in "$@"; do
    case "$arg" in
      --cli)
        target_scope="cli"
        ;;
      --acp)
        target_scope="acp"
        ;;
      gemini|Gemini|claude|Claude)
        local lower="${arg,,}"
        [[ "$lower" == "gemini" ]] && target_model="Gemini"
        [[ "$lower" == "claude" ]] && target_model="Claude"
        ;;
      *)
        if [[ -z "$desired_auth" ]]; then
          desired_auth="$arg"
        else
          echo -e "${C_RED}Error: unexpected argument '$arg' for swap${C_RESET}" >&2
          return 1
        fi
        ;;
    esac
  done

  if [[ -n "$desired_auth" ]]; then
    read_fields "$(AUTH_line "$desired_auth")" || true
    if [[ -z "${SPLIT[0]}" ]]; then
      echo -e "${C_RED}Error: profile '$desired_auth' not found. Run 'agyy status' to see saved profiles.${C_RESET}" >&2
      return 1
    fi
    best_name="${SPLIT[0]}"
  else
    local preferred_profile=""
    if [[ "$target_scope" == "cli" ]]; then
      preferred_profile=$(find_active_acp_AUTH 2>/dev/null || true)
    elif [[ "$target_scope" == "acp" ]]; then
      preferred_profile=$(find_active_AUTH 2>/dev/null || true)
    fi
    pick_AUTH "$target_model" "$preferred_profile" || return 1
  fi

  local AUTH_file="${AUTH_DIR}/antigravity-oauth-token-${best_name}"
  if [[ ! -f "$AUTH_file" ]]; then
    echo -e "${C_RED}Error: profile file not found: $AUTH_file${C_RESET}" >&2
    return 1
  fi
  local ref_token
  ref_token=$(get_refresh_AUTH "$AUTH_file") || ref_token=""
  if [[ -z "$ref_token" ]]; then
    echo -e "${C_RED}Error: could not extract refresh token from $AUTH_file${C_RESET}" >&2
    return 1
  fi

  if [[ "$target_scope" != "acp" ]]; then
    cp -p "$AUTH_file" "$TARGET_AUTH"
    chmod 600 "$TARGET_AUTH"
  fi
  if [[ "$target_scope" != "cli" ]]; then
    write_acp_token "$ref_token" "$AUTH_file"
    reload_acp_daemons "$best_name"
  fi

  local scope_desc="CLI & ACP"
  [[ "$target_scope" == "cli" ]] && scope_desc="CLI only"
  [[ "$target_scope" == "acp" ]] && scope_desc="ACP only"
  echo -e "${C_GREEN}✔ Switched active profile to ${C_BOLD}${best_name}${C_RESET} ${C_DIM}(${scope_desc})${C_RESET}"
  sync_AUTHs_bg
}

prepare_AUTH() {
  local target_model=""
  local tm_lower="${1,,}"
  [[ "$tm_lower" == "gemini" ]] && target_model="Gemini"
  [[ "$tm_lower" == "claude" ]] && target_model="Claude"
  local active_name
  active_name=$(find_active_AUTH 2>/dev/null) || active_name=""
  
  local has_model=0
  if [[ -n "$active_name" ]]; then
    read_fields "$(AUTH_line "$active_name")" || true
    AUTH_stat
    if [[ "$target_model" == "Gemini" ]]; then
      (( M_HEALTH_G == 1 )) && has_model=1
    elif [[ "$target_model" == "Claude" ]]; then
      (( M_HEALTH_C == 1 )) && has_model=1
    else
      (( M_HEALTH_G == 1 && M_HEALTH_C == 1 )) && has_model=1
    fi
  fi

  if (( has_model == 1 )); then
    local cur_acp_name
    cur_acp_name=$(find_active_acp_AUTH 2>/dev/null) || cur_acp_name=""
    if [[ -n "$active_name" && "$cur_acp_name" != "$active_name" ]]; then
      local active_file="${AUTH_DIR}/antigravity-oauth-token-${active_name}"
      if [[ -f "$active_file" ]]; then
        local active_ref
        active_ref=$(get_refresh_AUTH "$active_file") || active_ref=""
        if [[ -n "$active_ref" ]]; then
          write_acp_token "$active_ref" "$active_file" 2>/dev/null || true
          reload_acp_daemons "$active_name" 2>/dev/null || true
        fi
      fi
    fi
    sync_AUTHs_bg
    return 0
  fi

  # Out of quota or missing active auth -> sync live data and swap
  sync_AUTHs
  local preferred_profile
  preferred_profile=$(find_active_acp_AUTH 2>/dev/null || true)
  pick_AUTH "$target_model" "$preferred_profile" || return 1
  
  if [[ "$best_name" == "$active_name" ]]; then
    echo -e "${C_RED}Error: all available profiles are currently out of quota.${C_RESET}" >&2
    return 1
  fi

  swap_AUTH "$best_name" "$target_model"
}

cmd_save() {
  local new_name=""
  local force_source=""

  for arg in "$@"; do
    if [[ "$arg" == "--acp" ]]; then
      force_source="acp"
    elif [[ "$arg" == "--cli" ]]; then
      force_source="cli"
    elif [[ -z "$new_name" ]]; then
      new_name="$arg"
    fi
  done

  local cli_ref acp_ref cli_tracked acp_tracked
  sync_t3_profiles 2>/dev/null || true
  cli_ref=$(get_refresh_AUTH "$TARGET_AUTH" 2>/dev/null || true)
  acp_ref=$(get_refresh_AUTH "$TARGET_ACP_AUTH" 2>/dev/null || true)
  cli_tracked=$(find_active_AUTH 2>/dev/null || true)
  acp_tracked=$(find_active_acp_AUTH 2>/dev/null || true)

  local source_type=""
  local source_ref=""

  if [[ "$force_source" == "acp" ]]; then
    if [[ -z "$acp_ref" ]]; then
      echo -e "${C_RED}Error: no active ACP session found at $TARGET_ACP_AUTH${C_RESET}" >&2
      return 1
    fi
    if [[ -n "$acp_tracked" ]]; then
      echo -e "${C_YELLOW}ℹ Active ACP session is already saved as '${C_BOLD}${acp_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
      return 0
    fi
    source_type="acp"
    source_ref="$acp_ref"
  elif [[ "$force_source" == "cli" ]]; then
    if [[ -z "$cli_ref" ]]; then
      echo -e "${C_RED}Error: no active CLI session found at $TARGET_AUTH${C_RESET}" >&2
      echo -e "${C_DIM}Run 'agyy' to log in first.${C_RESET}" >&2
      return 1
    fi
    if [[ -n "$cli_tracked" ]]; then
      echo -e "${C_YELLOW}ℹ Active CLI session is already saved as '${C_BOLD}${cli_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
      return 0
    fi
    source_type="cli"
    source_ref="$cli_ref"
  else
    if [[ -z "$cli_ref" && -z "$acp_ref" ]]; then
      echo -e "${C_RED}Error: no active session found at $TARGET_AUTH or $TARGET_ACP_AUTH${C_RESET}" >&2
      echo -e "${C_DIM}Run 'agyy' or your ACP editor plugin to log in first.${C_RESET}" >&2
      return 1
    fi

    if [[ -n "$cli_ref" && -z "$acp_ref" ]]; then
      if [[ -n "$cli_tracked" ]]; then
        echo -e "${C_YELLOW}ℹ Active CLI session is already saved as '${C_BOLD}${cli_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
        return 0
      fi
      source_type="cli"
      source_ref="$cli_ref"
    elif [[ -z "$cli_ref" && -n "$acp_ref" ]]; then
      if [[ -n "$acp_tracked" ]]; then
        echo -e "${C_YELLOW}ℹ Active ACP session is already saved as '${C_BOLD}${acp_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
        return 0
      fi
      source_type="acp"
      source_ref="$acp_ref"
    else
      if [[ "$cli_ref" == "$acp_ref" ]]; then
        if [[ -n "$cli_tracked" ]]; then
          echo -e "${C_YELLOW}ℹ Active session is already saved as '${C_BOLD}${cli_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
          return 0
        fi
        source_type="cli"
        source_ref="$cli_ref"
      else
        if [[ -n "$cli_tracked" && -z "$acp_tracked" ]]; then
          echo -e "${C_DIM}ℹ CLI session is already tracked ('${cli_tracked}'). Saving untracked ACP session.${C_RESET}"
          source_type="acp"
          source_ref="$acp_ref"
        elif [[ -z "$cli_tracked" && -n "$acp_tracked" ]]; then
          echo -e "${C_DIM}ℹ ACP session is already tracked ('${acp_tracked}'). Saving untracked CLI session.${C_RESET}"
          source_type="cli"
          source_ref="$cli_ref"
        elif [[ -n "$cli_tracked" && -n "$acp_tracked" ]]; then
          echo -e "${C_YELLOW}ℹ Both sessions are already tracked (CLI: '${cli_tracked}', ACP: '${acp_tracked}').${C_RESET}"
          return 0
        else
          echo -e "${C_YELLOW}ℹ Both CLI and ACP have differing untracked sessions. Saving CLI by default (use --acp to save ACP).${C_RESET}"
          source_type="cli"
          source_ref="$cli_ref"
        fi
      fi
    fi
  fi

  while [[ -z "$new_name" ]]; do
    read -p "Profile name (e.g. work, personal): " -r new_name || return 1
    new_name=$(printf '%s' "$new_name" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  done

  if [[ ! "$new_name" =~ ^[a-z0-9_-]+$ ]]; then
    echo -e "${C_RED}Error: invalid name '$new_name'. Use alphanumeric characters, hyphens, or underscores.${C_RESET}" >&2
    return 1
  fi

  local dest_file="$AUTH_DIR/antigravity-oauth-token-$new_name"
  if [[ -f "$dest_file" ]]; then
    echo -e "${C_RED}Error: profile '$new_name' already exists at $dest_file${C_RESET}" >&2
    return 1
  fi

  if [[ "$source_type" == "cli" ]]; then
    cp -p "$TARGET_AUTH" "$dest_file"
    chmod 600 "$dest_file"
  else
    cat << EOF > "$dest_file"
{
  "auth_method": "consumer",
  "token": {
    "access_token": "",
    "token_type": "Bearer",
    "refresh_token": "$source_ref",
    "expiry": ""
  }
}
EOF
    chmod 600 "$dest_file"
    if [[ ! -f "$TARGET_AUTH" ]]; then
      cp -p "$dest_file" "$TARGET_AUTH"
      chmod 600 "$TARGET_AUTH"
    fi
  fi

  write_acp_token "$source_ref" "$dest_file"
  reload_acp_daemons "$new_name"
  echo -e "${C_GREEN}✔ Saved active session as '${C_BOLD}${new_name}${C_RESET}${C_GREEN}' (CLI & ACP).${C_RESET}"
  sync_AUTHs_bg
}

