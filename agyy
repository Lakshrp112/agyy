#!/usr/bin/env bash
set -euo pipefail

AUTH_DIR="${AUTH_DIR:-$HOME/.agy_toys/auth}"
TARGET_AUTH="${TARGET_AUTH:-$HOME/.gemini/antigravity-cli/antigravity-oauth-token}"
TARGET_ACP_AUTH="${TARGET_ACP_AUTH:-$HOME/.gemini/antigravity-acp/acp_token.json}"
T3_USERDATA_DIR="${T3_USERDATA_DIR:-$HOME/.t3/userdata}"
USAGE_FILE="$AUTH_DIR/auth_usage.csv"
LOCK_DIR="$AUTH_DIR/.lock"
DEL=","

REFRESH="7d"
DEFAULT_QUOTA=100

# ANSI Color Codes (enabled only if stdout is a TTY)
if [[ -t 1 ]]; then
  C_RESET=$'\e[0m'
  C_BOLD=$'\e[1m'
  C_DIM=$'\e[2m'
  C_RED=$'\e[31m'
  C_GREEN=$'\e[32m'
  C_YELLOW=$'\e[33m'
  C_BLUE=$'\e[34m'
  C_MAGENTA=$'\e[35m'
  C_CYAN=$'\e[36m'
  C_WHITE=$'\e[37m'
  C_BRIGHT_GREEN=$'\e[92m'
  C_BRIGHT_YELLOW=$'\e[93m'
  C_BRIGHT_RED=$'\e[91m'
else
  C_RESET=''
  C_BOLD=''
  C_DIM=''
  C_RED=''
  C_GREEN=''
  C_YELLOW=''
  C_BLUE=''
  C_MAGENTA=''
  C_CYAN=''
  C_WHITE=''
  C_BRIGHT_GREEN=''
  C_BRIGHT_YELLOW=''
  C_BRIGHT_RED=''
fi

mkdir -p "$AUTH_DIR"
mkdir -p "$(dirname "$TARGET_AUTH")"
mkdir -p "$(dirname "$TARGET_ACP_AUTH")"
[[ -f "$USAGE_FILE" ]] || : > "$USAGE_FILE"

re_escape() {
  printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g'
}

is_int() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

parse_refresh() {
  local str="$1" compact d h m seconds=0
  compact=$(printf '%s' "$str" | tr -d '[:space:]')
  if [[ "$compact" =~ ([0-9]+)d ]]; then
    d=${BASH_REMATCH[1]}; seconds=$(( seconds + d * 86400 ))
    compact=${compact/"${d}d"/}
  fi
  if [[ "$compact" =~ ([0-9]+)h ]]; then
    h=${BASH_REMATCH[1]}; seconds=$(( seconds + h * 3600 ))
    compact=${compact/"${h}h"/}
  fi
  if [[ "$compact" =~ ([0-9]+)m ]]; then
    m=${BASH_REMATCH[1]}; seconds=$(( seconds + m * 60 ))
  fi
  printf '%d' "$seconds"
}

fmt_time() {
  local t=$1 h m s
  (( t < 0 )) && t=0
  h=$(( t / 3600 )); m=$(( (t % 3600) / 60 )); s=$(( t % 60 ))
  printf '%02dh%02dm%02ds' "$h" "$m" "$s"
}

acquire_lock() {
  local waited=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    local lock_pid=""
    [[ -f "$LOCK_DIR/pid" ]] && lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
    if [[ -z "$lock_pid" ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    sleep 0.05
    waited=$(( waited + 1 ))
    if (( waited > 40 )); then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      mkdir "$LOCK_DIR" 2>/dev/null && break
      echo -e "${C_RED}Error: could not acquire lock on $AUTH_DIR${C_RESET}" >&2
      return 1
    fi
  done
  echo "$$" > "$LOCK_DIR/pid" 2>/dev/null || true
  trap 'rm -rf "$LOCK_DIR" 2>/dev/null || true' EXIT
}

AUTH_line() {
  local esc
  esc=$(re_escape "$1")
  grep -E "^${esc}${DEL}" "$USAGE_FILE" | head -n1
}

read_fields() {
  SPLIT=()
  IFS="$DEL" read -r -a SPLIT <<< "$1"
  while (( ${#SPLIT[@]} < 9 )); do SPLIT[${#SPLIT[@]}]=""; done
}

get_access_AUTH() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  command -v jq >/dev/null 2>&1 && jq -r '.token.access_token // .access_token // (if (.token | type) == "string" then .token else empty end) // empty' "$f" 2>/dev/null || \
    sed -n -E 's/.*"(access_token|token)"[[:space:]]*:[[:space:]]*"(ya29\.[^"]*)".*/\2/p' "$f" | head -n1
}

get_expiry_AUTH() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  command -v jq >/dev/null 2>&1 && jq -r '.token.expiry // .expiry // empty' "$f" 2>/dev/null || \
    sed -n 's/.*"expiry"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1
}

get_refresh_AUTH() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  command -v jq >/dev/null 2>&1 && jq -r '.token.refresh_token // .refresh_token // empty' "$f" 2>/dev/null || \
    sed -n 's/.*"refresh_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1
}

write_acp_token() {
  local ref_token="$1"
  local src_or_acc="${2:-}"
  local explicit_exp="${3:-}"
  [[ -n "$ref_token" ]] || return 1
  local target_dir
  target_dir="$(dirname "$TARGET_ACP_AUTH")"
  mkdir -p "$target_dir"

  local tmp_file="$target_dir/.acp_token.tmp.$$"

  if command -v python3 >/dev/null 2>&1; then
    python3 - "$TARGET_ACP_AUTH" "$ref_token" "$src_or_acc" "$explicit_exp" "$tmp_file" << 'PYEOF'
import sys, json, os, urllib.request, urllib.parse, time, codecs
from datetime import datetime, timezone

target_path = sys.argv[1]
ref_token = sys.argv[2]
src_or_acc = sys.argv[3] if len(sys.argv) > 3 else ""
explicit_exp = sys.argv[4] if len(sys.argv) > 4 else ""
tmp_file = sys.argv[5] if len(sys.argv) > 5 else ""

client_id = codecs.decode('1071006060591-gzuffva2u21yper235igbybwu4t403rc.nccf.tbbtyrhfrepbagrag.pbz', 'rot_13')
client_secret = codecs.decode('TBPFCK-X58SJE486YqYW1zYO8fKP4m6dQNs', 'rot_13')

def is_valid_expiry(exp_str):
    if not exp_str:
        return False
    try:
        dt = datetime.fromisoformat(exp_str.replace('Z', '+00:00'))
        return (dt.timestamp() - time.time()) > 300
    except Exception:
        return False

data = {}
if os.path.isfile(target_path):
    try:
        with open(target_path, 'r') as f:
            loaded = json.load(f)
            if isinstance(loaded, dict):
                data = loaded
    except Exception:
        data = {}

acc_token = None
expiry = None
source_file = None

if src_or_acc:
    if os.path.isfile(src_or_acc):
        source_file = src_or_acc
        try:
            with open(src_or_acc, 'r') as f:
                src_data = json.load(f)
            tok_obj = src_data.get('token')
            if isinstance(tok_obj, dict):
                acc_token = tok_obj.get('access_token')
                expiry = tok_obj.get('expiry')
            else:
                acc_token = src_data.get('access_token')
                expiry = src_data.get('expiry')
        except Exception:
            pass
    elif src_or_acc.startswith('ya29.'):
        acc_token = src_or_acc
        expiry = explicit_exp

# If we still do not have a valid token/expiry, check data in target_path
if not acc_token or not is_valid_expiry(expiry):
    target_tok = data.get('token')
    target_exp = data.get('expiry')
    if target_tok and is_valid_expiry(target_exp):
        acc_token = target_tok
        expiry = target_exp

# If token is still missing or expired/expiring soon, refresh it via Google OAuth endpoint
if not acc_token or not is_valid_expiry(expiry):
    try:
        body = urllib.parse.urlencode({
            'client_id': client_id,
            'client_secret': client_secret,
            'grant_type': 'refresh_token',
            'refresh_token': ref_token,
        }).encode()
        req = urllib.request.Request('https://oauth2.googleapis.com/token', data=body, method='POST')
        with urllib.request.urlopen(req, timeout=10) as resp:
            rres = json.loads(resp.read().decode())
            new_at = rres.get('access_token')
            if new_at:
                acc_token = new_at
                expires_in = rres.get('expires_in', 3600)
                exp_dt = datetime.fromtimestamp(time.time() + expires_in, timezone.utc)
                expiry = exp_dt.strftime('%Y-%m-%dT%H:%M:%S.%fZ')

                # If source file exists, update it as well
                if source_file and os.path.isfile(source_file):
                    try:
                        with open(source_file, 'r') as sf:
                            sf_data = json.load(sf)
                        if isinstance(sf_data.get('token'), dict):
                            sf_data['token']['access_token'] = new_at
                            sf_data['token']['expiry'] = expiry
                        else:
                            sf_data['access_token'] = new_at
                            sf_data['expiry'] = expiry
                        with open(source_file, 'w') as sf:
                            json.dump(sf_data, sf, indent=2)
                        os.chmod(source_file, 0o600)
                    except Exception:
                        pass
    except Exception:
        pass

data['client_id'] = client_id
data['client_secret'] = client_secret
data['refresh_token'] = ref_token
if acc_token:
    data['token'] = acc_token
if expiry:
    data['expiry'] = expiry
data['token_uri'] = data.get('token_uri') or "https://oauth2.googleapis.com/token"
data['scopes'] = [
    "https://www.googleapis.com/auth/cloud-platform",
    "https://www.googleapis.com/auth/userinfo.email"
]
data['project_id'] = data.get('project_id') or "aicode-consumers"

with open(tmp_file, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
PYEOF
  elif command -v jq >/dev/null 2>&1; then
    local base_json="{}"
    [[ -f "$TARGET_ACP_AUTH" ]] && base_json=$(cat "$TARGET_ACP_AUTH" 2>/dev/null || echo "{}")
    local acc_token=""
    local expiry=""
    if [[ -f "$src_or_acc" ]]; then
      acc_token=$(get_access_AUTH "$src_or_acc" 2>/dev/null || true)
      expiry=$(get_expiry_AUTH "$src_or_acc" 2>/dev/null || true)
    elif [[ "$src_or_acc" == ya29.* ]]; then
      acc_token="$src_or_acc"
      expiry="$explicit_exp"
    fi
    local cid sec
    cid=$(tr 'A-Za-z' 'N-ZA-Mn-za-m' <<< '1071006060591-gzuffva2u21yper235igbybwu4t403rc.nccf.tbbtyrhfrepbagrag.pbz')
    sec=$(tr 'A-Za-z' 'N-ZA-Mn-za-m' <<< 'TBPFCK-X58SJE486YqYW1zYO8fKP4m6dQNs')
    jq --arg rt "$ref_token" \
       --arg at "$acc_token" \
       --arg exp "$expiry" \
       --arg cid "$cid" \
       --arg sec "$sec" \
       --arg uri "https://oauth2.googleapis.com/token" \
       --arg pid "aicode-consumers" \
       '.client_id = $cid |
        .client_secret = $sec |
        .refresh_token = $rt |
        (if ($at | length) > 0 then .token = $at else . end) |
        (if ($exp | length) > 0 then .expiry = $exp else . end) |
        .token_uri = (.token_uri // $uri) |
        .scopes = ["https://www.googleapis.com/auth/cloud-platform", "https://www.googleapis.com/auth/userinfo.email"] |
        .project_id = (.project_id // $pid)' <<< "$base_json" > "$tmp_file"
  else
    # Pure Bash fallback
    local cid sec
    cid=$(tr 'A-Za-z' 'N-ZA-Mn-za-m' <<< '1071006060591-gzuffva2u21yper235igbybwu4t403rc.nccf.tbbtyrhfrepbagrag.pbz')
    sec=$(tr 'A-Za-z' 'N-ZA-Mn-za-m' <<< 'TBPFCK-X58SJE486YqYW1zYO8fKP4m6dQNs')
    local uri="https://oauth2.googleapis.com/token"
    local pid="aicode-consumers"
    local acc_token=""
    local expiry=""
    if [[ -f "$src_or_acc" ]]; then
      acc_token=$(get_access_AUTH "$src_or_acc" 2>/dev/null || true)
      expiry=$(get_expiry_AUTH "$src_or_acc" 2>/dev/null || true)
    elif [[ "$src_or_acc" == ya29.* ]]; then
      acc_token="$src_or_acc"
      expiry="$explicit_exp"
    fi
    cat << EOF > "$tmp_file"
{
  "client_id": "$cid",
  "client_secret": "$sec",
  "refresh_token": "$ref_token",
  "token": "$acc_token",
  "expiry": "$expiry",
  "token_uri": "$uri",
  "scopes": [
    "https://www.googleapis.com/auth/cloud-platform",
    "https://www.googleapis.com/auth/userinfo.email"
  ],
  "project_id": "$pid"
}
EOF
  fi

  chmod 600 "$tmp_file"
  mv -f "$tmp_file" "$TARGET_ACP_AUTH"

  sync_t3_profiles
}

sync_t3_profiles() {
  local t3_base="$T3_USERDATA_DIR/providers/antigravity"
  [[ -d "$t3_base" ]] || return 0

  # Forward sync: if TARGET_ACP_AUTH exists and has a token, sync to all T3Code instances
  if [[ -f "$TARGET_ACP_AUTH" ]]; then
    local target_token
    target_token=$(get_refresh_AUTH "$TARGET_ACP_AUTH" 2>/dev/null || true)
    if [[ -n "$target_token" ]]; then
      local cur_at cur_exp
      cur_at=$(get_access_AUTH "$TARGET_ACP_AUTH" 2>/dev/null || true)
      cur_exp=$(get_expiry_AUTH "$TARGET_ACP_AUTH" 2>/dev/null || true)
      if [[ "${_IN_SYNC_T3:-0}" -eq 0 && (-z "$cur_at" || -z "$cur_exp") ]]; then
        _IN_SYNC_T3=1 write_acp_token "$target_token" 2>/dev/null || true
      fi

      for t3_inst in "$t3_base"/*; do
        if [[ -d "$t3_inst" ]]; then
          local t3_acp_dir="$t3_inst/antigravity-acp"
          mkdir -p "$t3_acp_dir"
          local t3_token="$t3_acp_dir/acp_token.json"
          if [[ ! -f "$t3_token" ]] || ! cmp -s "$TARGET_ACP_AUTH" "$t3_token"; then
            local tmp_t3="$t3_acp_dir/.acp_token.tmp.$$"
            cp -f "$TARGET_ACP_AUTH" "$tmp_t3" 2>/dev/null && \
              chmod 600 "$tmp_t3" 2>/dev/null && \
              mv -f "$tmp_t3" "$t3_token" 2>/dev/null || true
          fi
        fi
      done
      return 0
    fi
  fi

  # Reverse sync: if TARGET_ACP_AUTH is missing or empty, see if any T3Code instance has a valid token
  for t3_inst in "$t3_base"/*; do
    if [[ -d "$t3_inst" ]]; then
      local t3_token="$t3_inst/antigravity-acp/acp_token.json"
      if [[ -f "$t3_token" ]]; then
        local t3_ref
        t3_ref=$(get_refresh_AUTH "$t3_token" 2>/dev/null || true)
        if [[ -n "$t3_ref" ]]; then
          local target_dir
          target_dir="$(dirname "$TARGET_ACP_AUTH")"
          mkdir -p "$target_dir"
          local tmp_main="$target_dir/.acp_token.tmp.$$"
          cp -f "$t3_token" "$tmp_main" 2>/dev/null && \
            chmod 600 "$tmp_main" 2>/dev/null && \
            mv -f "$tmp_main" "$TARGET_ACP_AUTH" 2>/dev/null || true
          break
        fi
      fi
    fi
  done
}

reload_acp_daemons() {
  local profile_name="${1:-}"

  # 1. Custom reload command from environment
  if [[ -n "${ACP_RELOAD_CMD:-}" ]]; then
    eval "$ACP_RELOAD_CMD" 2>/dev/null || true
  fi

  # 2. Executable hook scripts in ~/.agy_toys/auth/hooks
  local hook_dir="$AUTH_DIR/hooks"
  if [[ -x "$hook_dir/on_acp_reload" ]]; then
    "$hook_dir/on_acp_reload" "$profile_name" "$TARGET_ACP_AUTH" 2>/dev/null || true
  fi
  if [[ -x "$hook_dir/on_swap" ]]; then
    "$hook_dir/on_swap" "$profile_name" "$TARGET_AUTH" "$TARGET_ACP_AUTH" 2>/dev/null || true
  fi

  # 3. Detect and signal running ACP processes
  local acp_pids=()
  while IFS= read -r pid; do
    [[ -n "$pid" && "$pid" != "$$" ]] && acp_pids+=("$pid")
  done < <(pgrep -f "antigravity-acp|agy_acp_server|agy.*--acp" 2>/dev/null || true)

  if (( ${#acp_pids[@]} > 0 )); then
    local sig="${ACP_RELOAD_SIGNAL:-HUP}"
    kill -s "${sig}" "${acp_pids[@]}" 2>/dev/null || kill "-${sig}" "${acp_pids[@]}" 2>/dev/null || true
    echo -e "${C_DIM}ℹ Notified ${#acp_pids[@]} running ACP process(es) (SIG${sig}).${C_RESET}"
  fi
}

cmd_reload_acp() {
  local active_name
  active_name=$(find_active_AUTH 2>/dev/null) || active_name=""
  reload_acp_daemons "$active_name"
  echo -e "${C_GREEN}✔ ACP reload signal dispatched.${C_RESET}"
}

model_stat_calc() {
  local q="$1" r="$2" u="$3" l="$4" now window_end
  now=$(date +%s)
  is_int "$q" || q=0
  is_int "$u" || u=0
  is_int "$l" || l=0
  window_end=$(( l + $(parse_refresh "$r") ))
  W_WEND=$window_end
  if (( now >= window_end )); then
    W_EFF=0; W_LEFT=0; W_RESET=1
  else
    W_EFF=$u; W_LEFT=$(( window_end - now )); W_RESET=0
  fi
  if (( W_LEFT < 0 )); then
    W_LEFT=0
  fi
  W_PCT=0
  if (( q > 0 )); then
    W_PCT=$(( W_EFF * 100 / q ))
  fi
  if (( W_PCT > 100 )); then
    W_PCT=100
  fi
}

AUTH_stat() {
  # Gemini (G)
  model_stat_calc "${SPLIT[1]:-0}" "${SPLIT[2]:-$REFRESH}" "${SPLIT[3]:-0}" "${SPLIT[4]:-0}"
  M_EFF_G=$W_EFF; M_LEFT_G=$W_LEFT; M_RESET_G=$W_RESET; M_PCT_G=$W_PCT
  M_QUOTA_G="${SPLIT[1]:-0}"; M_U_G="${SPLIT[3]:-0}"; M_L_G="${SPLIT[4]:-0}"; M_R_G="${SPLIT[2]:-$REFRESH}"
  M_WEND_G=$W_WEND

  # Claude (C)
  model_stat_calc "${SPLIT[5]:-0}" "${SPLIT[6]:-$REFRESH}" "${SPLIT[7]:-0}" "${SPLIT[8]:-0}"
  M_EFF_C=$W_EFF; M_LEFT_C=$W_LEFT; M_RESET_C=$W_RESET; M_PCT_C=$W_PCT
  M_QUOTA_C="${SPLIT[5]:-0}"; M_U_C="${SPLIT[7]:-0}"; M_L_C="${SPLIT[8]:-0}"; M_R_C="${SPLIT[6]:-$REFRESH}"
  M_WEND_C=$W_WEND
}

usage_field() {
  local u="$1" q="$2" pct=0 w=20 filled i bar="["
  if (( q > 0 )); then
    pct=$(( u * 100 / q ))
  fi
  if (( pct > 100 )); then
    pct=100
  fi
  if (( pct < 0 )); then
    pct=0
  fi
  filled=$(( pct * w / 100 ))
  
  local color=""
  if (( pct >= 80 )); then
    color="${C_RED}"
  elif (( pct >= 50 )); then
    color="${C_YELLOW}"
  else
    color="${C_GREEN}"
  fi

  for ((i = 0; i < w; i++)); do
    if (( i < filled )); then 
      bar+="${color}#${C_RESET}"
    else 
      bar+=" "
    fi
  done
  bar+="]"
  printf '%s %03d%%' "$bar" "$pct"
}

cmd_whoami() {
  local scope="all" short=0
  for arg in "$@"; do
    case "$arg" in
      --cli)
        scope="cli"
        ;;
      --acp)
        scope="acp"
        ;;
      -s|--short)
        short=1
        ;;
      *)
        echo -e "${C_RED}Error: unknown option '$arg' for whoami. Valid options: --cli, --acp, -s, --short${C_RESET}" >&2
        return 1
        ;;
    esac
  done

  sync_t3_profiles 2>/dev/null || true

  local cli_name acp_name
  cli_name=$(find_active_AUTH 2>/dev/null) || cli_name=""
  acp_name=$(find_active_acp_AUTH 2>/dev/null) || acp_name=""

  local cli_ref acp_ref
  cli_ref=$(get_refresh_AUTH "$TARGET_AUTH" 2>/dev/null) || cli_ref=""
  acp_ref=$(get_refresh_AUTH "$TARGET_ACP_AUTH" 2>/dev/null) || acp_ref=""

  if (( short == 1 )); then
    if [[ "$scope" == "cli" ]]; then
      if [[ -n "$cli_name" ]]; then
        echo "$cli_name"
        return 0
      fi
      return 1
    elif [[ "$scope" == "acp" ]]; then
      if [[ -n "$acp_name" ]]; then
        echo "$acp_name"
        return 0
      fi
      return 1
    else
      if [[ -n "$cli_name" && "$cli_name" == "$acp_name" ]]; then
        echo "$cli_name"
        return 0
      elif [[ -n "$cli_name" || -n "$acp_name" ]]; then
        echo "cli:${cli_name:-none} acp:${acp_name:-none}"
        return 0
      fi
      return 1
    fi
  fi

  if [[ "$scope" == "cli" ]]; then
    if [[ -n "$cli_name" ]]; then
      echo -e "${C_GREEN}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_WHITE}${cli_name}${C_RESET}"
    elif [[ -n "$cli_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name>)${C_RESET}"
    else
      echo -e "${C_DIM}● CLI profile: none configured${C_RESET}"
    fi
    return 0
  elif [[ "$scope" == "acp" ]]; then
    if [[ -n "$acp_name" ]]; then
      echo -e "${C_GREEN}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_WHITE}${acp_name}${C_RESET}"
    elif [[ -n "$acp_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name> --acp)${C_RESET}"
    else
      echo -e "${C_DIM}● ACP profile: none configured${C_RESET}"
    fi
    return 0
  fi

  if [[ -n "$cli_name" && "$cli_name" == "$acp_name" ]]; then
    echo -e "${C_GREEN}● Active profile:${C_RESET} ${C_BOLD}${C_WHITE}${cli_name}${C_RESET} ${C_DIM}(CLI & ACP synced)${C_RESET}"
  elif [[ -n "$cli_name" ]]; then
    echo -e "${C_GREEN}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_WHITE}${cli_name}${C_RESET}"
    if [[ -n "$acp_name" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}${acp_name}${C_RESET} ${C_DIM}(desynced — run 'agyy swap ${cli_name}' to align)${C_RESET}"
    elif [[ -n "$acp_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name> --acp)${C_RESET}"
    else
      echo -e "${C_DIM}● ACP profile: none configured${C_RESET}"
    fi
  elif [[ -n "$acp_name" ]]; then
    if [[ -n "$cli_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name>)${C_RESET}"
    else
      echo -e "${C_DIM}● CLI profile: none configured${C_RESET}"
    fi
    echo -e "${C_GREEN}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_WHITE}${acp_name}${C_RESET}"
  elif [[ -n "$cli_ref" || -n "$acp_ref" ]]; then
    if [[ -n "$cli_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (CLI):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name>)${C_RESET}"
    fi
    if [[ -n "$acp_ref" ]]; then
      echo -e "${C_YELLOW}● Active profile (ACP):${C_RESET} ${C_BOLD}${C_YELLOW}[untracked session]${C_RESET} ${C_DIM}(save with: agyy save <name> --acp)${C_RESET}"
    fi
  else
    echo -e "${C_YELLOW}No active profile configured. Run 'agyy' to log in.${C_RESET}"
  fi
}

revoke_AUTH_token() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  local ref_token acc_token
  ref_token=$(get_refresh_AUTH "$f") || ref_token=""
  acc_token=$(get_access_AUTH "$f") || acc_token=""

  local target_token="${ref_token:-$acc_token}"
  if [[ -n "$target_token" ]]; then
    echo -e "${C_DIM}Revoking token on Google servers...${C_RESET}"
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" -X POST -d "token=${target_token}" https://oauth2.googleapis.com/revoke 2>/dev/null || echo "000")
    if [[ "$http_code" == "200" ]]; then
      echo -e "${C_GREEN}✔ Token revoked on Google servers.${C_RESET}"
    else
      echo -e "${C_YELLOW}ℹ Google Revoke response: HTTP ${http_code} (token may already be inactive).${C_RESET}"
    fi
  fi
}

cmd_delete() {
  local target_name=""
  local force=0
  local do_revoke=0
  local specified_revoke_flag=0

  for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--force" || "$arg" == "-y" ]]; then
      force=1
    elif [[ "$arg" == "-r" || "$arg" == "--revoke" ]]; then
      do_revoke=1
      specified_revoke_flag=1
    elif [[ -z "$target_name" ]]; then
      target_name="$arg"
    fi
  done

  if [[ -z "$target_name" ]]; then
    shopt -s nullglob
    local auth_files=("$AUTH_DIR"/antigravity-oauth-token-*)
    shopt -u nullglob
    if (( ${#auth_files[@]} == 0 )); then
      echo -e "${C_RED}No auth profiles found in $AUTH_DIR.${C_RESET}" >&2
      return 1
    fi

    echo -e "${C_BOLD}Saved profiles:${C_RESET}"
    for f in "${auth_files[@]}"; do
      local n="${f##*antigravity-oauth-token-}"
      echo -e "  - ${C_CYAN}${n}${C_RESET}"
    done
    echo
    read -p "Profile name to delete: " -r target_name || return 1
    target_name=$(printf '%s' "$target_name" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  fi

  if [[ -z "$target_name" ]]; then
    echo -e "${C_RED}Error: no profile name specified.${C_RESET}" >&2
    return 1
  fi

  local target_file="$AUTH_DIR/antigravity-oauth-token-$target_name"
  local active_name
  active_name=$(find_active_AUTH) || active_name=""
  local is_active=0
  [[ "$target_name" == "$active_name" ]] && is_active=1

  if (( is_active == 1 && force == 0 )); then
    local confirm
    echo -e "${C_YELLOW}⚠ Warning: '${C_BOLD}${target_name}${C_RESET}${C_YELLOW}' is the active profile.${C_RESET}"
    read -p "Delete and auto-switch to next available profile? (y/N): " -r confirm || confirm="n"
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo -e "${C_DIM}Deletion cancelled.${C_RESET}"
      return 0
    fi
  fi

  if (( specified_revoke_flag == 0 && force == 0 )); then
    local ask_revoke
    read -p "Also permanently revoke token on Google servers? (y/N): " -r ask_revoke || ask_revoke="n"
    if [[ "$ask_revoke" =~ ^[Yy]$ ]]; then
      do_revoke=1
    fi
  fi

  if (( do_revoke == 1 )) && [[ -f "$target_file" ]]; then
    revoke_AUTH_token "$target_file"
  fi

  local removed=0
  if [[ -f "$target_file" ]]; then
    rm -f "$target_file"
    removed=1
  fi

  if [[ -f "$USAGE_FILE" ]]; then
    local esc tmp
    esc=$(re_escape "$target_name")
    tmp=$(mktemp)
    grep -v -E "^${esc}${DEL}" "$USAGE_FILE" > "$tmp" || true
    mv "$tmp" "$USAGE_FILE"
  fi

  if (( removed == 1 )); then
    echo -e "${C_GREEN}✔ Deleted profile '${C_BOLD}${target_name}${C_RESET}${C_GREEN}'.${C_RESET}"
    if (( is_active == 1 )); then
      echo -e "${C_DIM}Switching to next available profile...${C_RESET}"
      prepare_AUTH "" || true
    fi
  else
    echo -e "${C_YELLOW}Profile '${target_name}' not found in $AUTH_DIR.${C_RESET}"
  fi
}

cmd_status() {
  sync_t3_profiles 2>/dev/null || true

  local filter_model=""
  local filter_auth=""

  for arg in "$@"; do
    case "$arg" in
      --cli|--acp)
        echo -e "${C_RED}Error: 'agyy status' does not take '--cli' or '--acp' flags. Use 'agyy whoami [--cli|--acp]' to inspect active scopes.${C_RESET}" >&2
        return 1
        ;;
      gemini|Gemini|claude|Claude)
        local lower="${arg,,}"
        [[ "$lower" == "gemini" ]] && filter_model="Gemini"
        [[ "$lower" == "claude" ]] && filter_model="Claude"
        ;;
      -*)
        echo -e "${C_RED}Error: unknown option '$arg' for status. Valid syntax: agyy status [name] [model]${C_RESET}" >&2
        return 1
        ;;
      *)
        if [[ -z "$filter_auth" ]]; then
          filter_auth="$arg"
        fi
        ;;
    esac
  done

  local active_name acp_name acp_status
  active_name=$(find_active_AUTH 2>/dev/null) || active_name=""
  acp_name=$(find_active_acp_AUTH 2>/dev/null) || acp_name=""
  if [[ -n "$active_name" && "$active_name" == "$acp_name" ]]; then
    acp_status="${C_GREEN}synced${C_RESET}"
  elif [[ -n "$acp_name" ]]; then
    acp_status="${C_YELLOW}${acp_name}${C_RESET}"
  elif [[ -f "$TARGET_ACP_AUTH" ]]; then
    acp_status="${C_YELLOW}untracked${C_RESET}"
  else
    acp_status="${C_DIM}none${C_RESET}"
  fi

  local yolo_status continue_status
  [[ -f "$YOLO_FILE" ]] && yolo_status="${C_GREEN}ON${C_RESET}" || yolo_status="${C_YELLOW}OFF${C_RESET}"
  [[ -f "$CONTINUE_FILE" ]] && continue_status="${C_GREEN}ON${C_RESET}" || continue_status="${C_YELLOW}OFF${C_RESET}"

  local total_auths=0
  [[ -f "$USAGE_FILE" ]] && total_auths=$(grep -c . "$USAGE_FILE" 2>/dev/null || echo 0)

  local now line name tmp
  now=$(date +%s)
  tmp=$(mktemp)
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    read_fields "$line"
    name="${SPLIT[0]}"
    AUTH_stat
    local blocked_count=0
    local kg=$now
    if (( M_L_G >= 2000000000 )); then
      kg=$M_L_G
      blocked_count=$(( blocked_count + 1 ))
    elif (( M_EFF_G >= M_QUOTA_G )); then
      kg=$M_WEND_G
      if (( M_RESET_G == 1 || now >= M_WEND_G )); then
        kg=$now
      else
        blocked_count=$(( blocked_count + 1 ))
      fi
    fi
    local kc=$now
    if (( M_L_C >= 2000000000 )); then
      kc=$M_L_C
      blocked_count=$(( blocked_count + 1 ))
    elif (( M_EFF_C >= M_QUOTA_C )); then
      kc=$M_WEND_C
      if (( M_RESET_C == 1 || now >= M_WEND_C )); then
        kc=$now
      else
        blocked_count=$(( blocked_count + 1 ))
      fi
    fi
    local key=$now
    if (( blocked_count == 1 )); then
      local blocked_time=$kg
      if (( kc > kg )); then
        blocked_time=$kc
      fi
      key=$(( 1000000000 + blocked_time ))
    elif (( blocked_count == 2 )); then
      local first_reset=$kg
      if (( kc < kg )); then
        first_reset=$kc
      fi
      key=$(( 2000000000 + first_reset ))
    fi
    local rstr_g rstr_c
    if (( M_L_G >= 2000000000 )); then
      rstr_g="${C_RED}REVOKED${C_RESET}"
    elif (( M_RESET_G == 1 )); then
      rstr_g="${C_BRIGHT_GREEN}READY${C_RESET}"
    else
      rstr_g="${C_YELLOW}$(fmt_time "$M_LEFT_G")${C_RESET}"
    fi

    if (( M_L_C >= 2000000000 )); then
      rstr_c="${C_RED}REVOKED${C_RESET}"
    elif (( M_RESET_C == 1 )); then
      rstr_c="${C_BRIGHT_GREEN}READY${C_RESET}"
    else
      rstr_c="${C_YELLOW}$(fmt_time "$M_LEFT_C")${C_RESET}"
    fi

    printf '%d\t%s\tGemini\t%d\t%d\t%s\t%s\tClaude\t%d\t%d\t%s\t%s\n' \
      "$key" "$name" \
      "$M_EFF_G" "$M_QUOTA_G" "$rstr_g" "$M_R_G" \
      "$M_EFF_C" "$M_QUOTA_C" "$rstr_c" "$M_R_C" >> "$tmp"
  done < "$USAGE_FILE"

  if [[ ! -s "$tmp" ]]; then
    echo -e "  ${C_RED}No auths detected in $AUTH_DIR${C_RESET}"
    rm -f "$tmp"
    return 0
  fi

  local header_active=""
  if [[ -n "$active_name" && "$active_name" == "$acp_name" ]]; then
    header_active="Active: ${C_BOLD}${C_WHITE}${active_name}${C_RESET} ${C_DIM}|${C_RESET} ACP: ${acp_status}"
  else
    local c_disp="${active_name:-none}"
    local a_disp="${acp_name:-none}"
    header_active="CLI: ${C_BOLD}${C_WHITE}${c_disp}${C_RESET} ${C_DIM}|${C_RESET} ACP: ${C_BOLD}${C_YELLOW}${a_disp}${C_RESET}"
  fi

  echo -e "  ${C_BOLD}${C_CYAN}Antigravity Auth Pool${C_RESET} ${C_DIM}|${C_RESET} ${header_active} ${C_DIM}|${C_RESET} YOLO: ${yolo_status} ${C_DIM}|${C_RESET} CONT: ${continue_status} ${C_DIM}|${C_RESET} Profiles: ${C_BOLD}${total_auths}${C_RESET}\n"

  local first=1
  printf "  %-2s %-20s %-8s %-27s   %-11s %s${C_RESET}\n" "" "AUTH" "MODEL" "USAGE" "LEFT" "COOLDOWN"
  echo -e "  ${C_DIM}--------------------------------------------------------------------------------------------${C_RESET}"
  sort -n "$tmp" | while IFS=$'\t' read -r _ name m1 u1 q1 r1 rf1 m2 u2 q2 r2 rf2; do
    if [[ -n "$filter_auth" && "$name" != "$filter_auth" ]]; then
      continue
    fi

    if (( first == 0 )); then
      echo
    else
      first=0
    fi

    local marker="  "
    local raw_text="$name"
    local name_display="${C_BOLD}${C_WHITE}${name}${C_RESET}"

    if [[ -n "$active_name" && "$active_name" == "$acp_name" && "$name" == "$active_name" ]]; then
      marker="${C_BRIGHT_GREEN}●${C_RESET} "
      raw_text="${name} (active)"
      name_display="${C_BOLD}${C_BRIGHT_GREEN}${name} (active)${C_RESET}"
    elif [[ "$name" == "$active_name" ]]; then
      marker="${C_GREEN}●${C_RESET} "
      raw_text="${name} (cli)"
      name_display="${C_BOLD}${C_GREEN}${name} (cli)${C_RESET}"
    elif [[ "$name" == "$acp_name" ]]; then
      marker="${C_YELLOW}◆${C_RESET} "
      raw_text="${name} (acp)"
      name_display="${C_BOLD}${C_YELLOW}${name} (acp)${C_RESET}"
    fi

    local pad_len=$(( 20 - ${#raw_text} ))
    (( pad_len < 1 )) && pad_len=1
    local pad
    pad=$(printf '%*s' "$pad_len" "")

    local left1=$(( q1 - u1 ))
    (( left1 < 0 )) && left1=0
    local left2=$(( q2 - u2 ))
    (( left2 < 0 )) && left2=0

    local left_color1="${C_GREEN}"
    (( left1 < 20 )) && left_color1="${C_RED}" || { (( left1 < 50 )) && left_color1="${C_YELLOW}"; }
    local left_color2="${C_GREEN}"
    (( left2 < 20 )) && left_color2="${C_RED}" || { (( left2 < 50 )) && left_color2="${C_YELLOW}"; }

    if [[ -z "$filter_model" || "$filter_model" == "Gemini" ]]; then
      printf "  %s%s%s %-8s %s   %s%03d / %-5d%s %s%s%s\n" \
        "${marker}" "${name_display}" "${pad}" \
        "${m1}" "$(usage_field "$u1" "$q1")" \
        "${left_color1}" "$left1" "$q1" "${C_RESET}" \
        "" "${r1}" ""
    fi
    if [[ -z "$filter_model" || "$filter_model" == "Claude" ]]; then
      if [[ "$filter_model" == "Claude" ]]; then
        printf "  %s%s%s %-8s %s   %s%03d / %-5d%s %s%s%s\n" \
          "${marker}" "${name_display}" "${pad}" \
          "${m2}" "$(usage_field "$u2" "$q2")" \
          "${left_color2}" "$left2" "$q2" "${C_RESET}" \
          "" "${r2}" ""
      else
        printf "    %-20s %-8s %s   %s%03d / %-5d%s %s%s%s\n" \
          "" \
          "${m2}" "$(usage_field "$u2" "$q2")" \
          "${left_color2}" "$left2" "$q2" "${C_RESET}" \
          "" "${r2}" ""
      fi
    fi
  done
  rm -f "$tmp"
}

pick_AUTH() {
  local target_model="${1:-}"
  local preferred_profile="${2:-}"
  local line found=0
  best_name=""; best_eff=999999; best_time=999999999; best_u=999999
  local pref_found=0 pref_name=""
  if [[ ! -s "$USAGE_FILE" ]]; then
    echo -e "${C_RED}No auths available.${C_RESET}" >&2
    return 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    read_fields "$line"
    AUTH_stat
    local eff left u q r reset
    local left_g=0
    if (( M_EFF_G >= M_QUOTA_G )); then
      left_g=$M_LEFT_G
    fi
    local left_c=0
    if (( M_EFF_C >= M_QUOTA_C )); then
      left_c=$M_LEFT_C
    fi

    if [[ "$target_model" == "Gemini" ]]; then
      eff=$M_EFF_G; left=$left_g; u=$M_U_G; q=$M_QUOTA_G; r=$M_R_G; reset=$M_RESET_G
    elif [[ "$target_model" == "Claude" ]]; then
      eff=$M_EFF_C; left=$left_c; u=$M_U_C; q=$M_QUOTA_C; r=$M_R_C; reset=$M_RESET_C
    else
      eff=$(( M_EFF_G + M_EFF_C ))
      left=$left_g
      if (( left_c > left )); then
        left=$left_c
      fi
      u=$(( M_U_G + M_U_C ))
      q=$(( M_QUOTA_G + M_QUOTA_C ))
      r="$M_R_G"
      reset=0
      if (( M_RESET_G == 1 && M_RESET_C == 1 )); then
        reset=1
      fi
    fi

    local is_healthy=0
    if (( left == 0 )) && { (( q == 0 )) || (( eff < q )) || (( reset == 1 )); }; then
      is_healthy=1
    fi

    if [[ -n "$preferred_profile" && "${SPLIT[0]}" == "$preferred_profile" && $is_healthy -eq 1 ]]; then
      pref_found=1
      pref_name="${SPLIT[0]}"
    fi

    local is_better=0
    if (( eff < best_eff )); then
      is_better=1
    elif (( eff == best_eff )); then
      if (( left < best_time )); then
        is_better=1
      elif (( left == 0 && best_time == 0 && u < best_u )); then
        is_better=1
      fi
    fi
    if (( is_better == 1 )); then
      best_name="${SPLIT[0]}"; best_eff=$eff; best_time=$left; found=1; best_u=$u
    fi
  done < "$USAGE_FILE"
  if (( pref_found == 1 )); then
    best_name="$pref_name"
    found=1
  fi
  if (( found == 0 )); then
    echo -e "${C_RED}No suitable auth found.${C_RESET}" >&2
    return 1
  fi
  return 0
}

match_profile_by_ref() {
  local target_ref="$1"
  [[ -n "$target_ref" ]] || return 1
  local f name
  shopt -s nullglob
  for f in "$AUTH_DIR"/antigravity-oauth-token-*; do
    local f_ref
    f_ref=$(get_refresh_AUTH "$f") || f_ref=""
    if [[ "$target_ref" == "$f_ref" ]]; then
      name=${f#"$AUTH_DIR"/"antigravity-oauth-token-"}
      shopt -u nullglob
      echo "$name"
      return 0
    fi
  done
  shopt -u nullglob
  return 1
}

find_active_AUTH() {
  [[ -f "$TARGET_AUTH" ]] || return 1
  local target_ref
  target_ref=$(get_refresh_AUTH "$TARGET_AUTH") || target_ref=""
  match_profile_by_ref "$target_ref"
}

find_active_acp_AUTH() {
  local target_ref=""
  if [[ -f "$TARGET_ACP_AUTH" ]]; then
    target_ref=$(get_refresh_AUTH "$TARGET_ACP_AUTH") || target_ref=""
  fi
  if [[ -z "$target_ref" ]]; then
    local t3_base="$T3_USERDATA_DIR/providers/antigravity"
    if [[ -d "$t3_base" ]]; then
      for t3_inst in "$t3_base"/*; do
        if [[ -f "$t3_inst/antigravity-acp/acp_token.json" ]]; then
          target_ref=$(get_refresh_AUTH "$t3_inst/antigravity-acp/acp_token.json" 2>/dev/null || true)
          [[ -n "$target_ref" ]] && break
        fi
      done
    fi
  fi
  [[ -n "$target_ref" ]] || return 1
  match_profile_by_ref "$target_ref"
}

swap_AUTH() {
  local target_scope="all"
  local desired_auth=""
  local target_model=""

  for arg in "$@"; do
    case "$arg" in
      --cli)
        target_scope="cli"
        ;;
      --acp)
        target_scope="acp"
        ;;
      gemini|Gemini|claude|Claude)
        local lower="${arg,,}"
        [[ "$lower" == "gemini" ]] && target_model="Gemini"
        [[ "$lower" == "claude" ]] && target_model="Claude"
        ;;
      *)
        if [[ -z "$desired_auth" ]]; then
          desired_auth="$arg"
        else
          echo -e "${C_RED}Error: unexpected argument '$arg' for swap${C_RESET}" >&2
          return 1
        fi
        ;;
    esac
  done

  if [[ -n "$desired_auth" ]]; then
    read_fields "$(AUTH_line "$desired_auth")" || true
    if [[ -z "${SPLIT[0]}" ]]; then
      echo -e "${C_RED}Error: profile '$desired_auth' not found. Run 'agyy status' to see saved profiles.${C_RESET}" >&2
      return 1
    fi
    best_name="${SPLIT[0]}"
  else
    local preferred_profile=""
    if [[ "$target_scope" == "cli" ]]; then
      preferred_profile=$(find_active_acp_AUTH 2>/dev/null || true)
    elif [[ "$target_scope" == "acp" ]]; then
      preferred_profile=$(find_active_AUTH 2>/dev/null || true)
    fi
    pick_AUTH "$target_model" "$preferred_profile" || return 1
  fi

  local AUTH_file="${AUTH_DIR}/antigravity-oauth-token-${best_name}"
  if [[ ! -f "$AUTH_file" ]]; then
    echo -e "${C_RED}Error: profile file not found: $AUTH_file${C_RESET}" >&2
    return 1
  fi
  local ref_token
  ref_token=$(get_refresh_AUTH "$AUTH_file") || ref_token=""
  if [[ -z "$ref_token" ]]; then
    echo -e "${C_RED}Error: could not extract refresh token from $AUTH_file${C_RESET}" >&2
    return 1
  fi

  if [[ "$target_scope" == "cli" ]]; then
    cp -p "$AUTH_file" "$TARGET_AUTH"
    chmod 600 "$TARGET_AUTH"
    echo -e "${C_GREEN}✔ Switched active CLI profile to ${C_BOLD}${best_name}${C_RESET} ${C_DIM}(CLI only)${C_RESET}"
  elif [[ "$target_scope" == "acp" ]]; then
    write_acp_token "$ref_token" "$AUTH_file"
    reload_acp_daemons "$best_name"
    echo -e "${C_GREEN}✔ Switched active ACP profile to ${C_BOLD}${best_name}${C_RESET} ${C_DIM}(ACP only)${C_RESET}"
  else
    cp -p "$AUTH_file" "$TARGET_AUTH"
    chmod 600 "$TARGET_AUTH"
    write_acp_token "$ref_token" "$AUTH_file"
    reload_acp_daemons "$best_name"
    echo -e "${C_GREEN}✔ Switched active profile to ${C_BOLD}${best_name}${C_RESET} ${C_DIM}(CLI & ACP)${C_RESET}"
  fi
  sync_AUTHs_bg
}

prepare_AUTH() {
  local target_model=""
  local tm_lower="${1,,}"
  [[ "$tm_lower" == "gemini" ]] && target_model="Gemini"
  [[ "$tm_lower" == "claude" ]] && target_model="Claude"
  local active_name
  active_name=$(find_active_AUTH 2>/dev/null) || active_name=""
  
  local has_model=0
  if [[ -n "$active_name" ]]; then
    read_fields "$(AUTH_line "$active_name")" || true
    AUTH_stat
    if [[ "$target_model" == "Gemini" ]]; then
      if (( M_LEFT_G == 0 || M_EFF_G < M_QUOTA_G )); then
        has_model=1
      fi
    elif [[ "$target_model" == "Claude" ]]; then
      if (( M_LEFT_C == 0 || M_EFF_C < M_QUOTA_C )); then
        has_model=1
      fi
    else
      if (( (M_LEFT_G == 0 || M_EFF_G < M_QUOTA_G) && (M_LEFT_C == 0 || M_EFF_C < M_QUOTA_C) )); then
        has_model=1
      fi
    fi
  fi

  if (( has_model == 1 )); then
    local cur_acp_name
    cur_acp_name=$(find_active_acp_AUTH 2>/dev/null) || cur_acp_name=""
    if [[ -n "$active_name" && "$cur_acp_name" != "$active_name" ]]; then
      local active_file="${AUTH_DIR}/antigravity-oauth-token-${active_name}"
      if [[ -f "$active_file" ]]; then
        local active_ref
        active_ref=$(get_refresh_AUTH "$active_file") || active_ref=""
        if [[ -n "$active_ref" ]]; then
          write_acp_token "$active_ref" "$active_file" 2>/dev/null || true
          reload_acp_daemons "$active_name" 2>/dev/null || true
        fi
      fi
    fi
    sync_AUTHs_bg
    return 0
  fi

  # Out of quota or missing active auth -> sync live data and swap
  sync_AUTHs
  local preferred_profile
  preferred_profile=$(find_active_acp_AUTH 2>/dev/null || true)
  pick_AUTH "$target_model" "$preferred_profile" || return 1
  
  if [[ "$best_name" == "$active_name" ]]; then
    echo -e "${C_RED}Error: all available profiles are currently out of quota.${C_RESET}" >&2
    return 1
  fi

  swap_AUTH "$best_name" "$target_model"
}

cmd_save() {
  local new_name=""
  local force_source=""

  for arg in "$@"; do
    if [[ "$arg" == "--acp" ]]; then
      force_source="acp"
    elif [[ "$arg" == "--cli" ]]; then
      force_source="cli"
    elif [[ -z "$new_name" ]]; then
      new_name="$arg"
    fi
  done

  local cli_ref acp_ref cli_tracked acp_tracked
  sync_t3_profiles 2>/dev/null || true
  cli_ref=$(get_refresh_AUTH "$TARGET_AUTH" 2>/dev/null || true)
  acp_ref=$(get_refresh_AUTH "$TARGET_ACP_AUTH" 2>/dev/null || true)
  cli_tracked=$(find_active_AUTH 2>/dev/null || true)
  acp_tracked=$(find_active_acp_AUTH 2>/dev/null || true)

  local source_type=""
  local source_ref=""

  if [[ "$force_source" == "acp" ]]; then
    if [[ -z "$acp_ref" ]]; then
      echo -e "${C_RED}Error: no active ACP session found at $TARGET_ACP_AUTH${C_RESET}" >&2
      return 1
    fi
    if [[ -n "$acp_tracked" ]]; then
      echo -e "${C_YELLOW}ℹ Active ACP session is already saved as '${C_BOLD}${acp_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
      return 0
    fi
    source_type="acp"
    source_ref="$acp_ref"
  elif [[ "$force_source" == "cli" ]]; then
    if [[ -z "$cli_ref" ]]; then
      echo -e "${C_RED}Error: no active CLI session found at $TARGET_AUTH${C_RESET}" >&2
      echo -e "${C_DIM}Run 'agyy' to log in first.${C_RESET}" >&2
      return 1
    fi
    if [[ -n "$cli_tracked" ]]; then
      echo -e "${C_YELLOW}ℹ Active CLI session is already saved as '${C_BOLD}${cli_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
      return 0
    fi
    source_type="cli"
    source_ref="$cli_ref"
  else
    if [[ -z "$cli_ref" && -z "$acp_ref" ]]; then
      echo -e "${C_RED}Error: no active session found at $TARGET_AUTH or $TARGET_ACP_AUTH${C_RESET}" >&2
      echo -e "${C_DIM}Run 'agyy' or your ACP editor plugin to log in first.${C_RESET}" >&2
      return 1
    fi

    if [[ -n "$cli_ref" && -z "$acp_ref" ]]; then
      if [[ -n "$cli_tracked" ]]; then
        echo -e "${C_YELLOW}ℹ Active CLI session is already saved as '${C_BOLD}${cli_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
        return 0
      fi
      source_type="cli"
      source_ref="$cli_ref"
    elif [[ -z "$cli_ref" && -n "$acp_ref" ]]; then
      if [[ -n "$acp_tracked" ]]; then
        echo -e "${C_YELLOW}ℹ Active ACP session is already saved as '${C_BOLD}${acp_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
        return 0
      fi
      source_type="acp"
      source_ref="$acp_ref"
    else
      if [[ "$cli_ref" == "$acp_ref" ]]; then
        if [[ -n "$cli_tracked" ]]; then
          echo -e "${C_YELLOW}ℹ Active session is already saved as '${C_BOLD}${cli_tracked}${C_RESET}${C_YELLOW}'.${C_RESET}"
          return 0
        fi
        source_type="cli"
        source_ref="$cli_ref"
      else
        if [[ -n "$cli_tracked" && -z "$acp_tracked" ]]; then
          echo -e "${C_DIM}ℹ CLI session is already tracked ('${cli_tracked}'). Saving untracked ACP session.${C_RESET}"
          source_type="acp"
          source_ref="$acp_ref"
        elif [[ -z "$cli_tracked" && -n "$acp_tracked" ]]; then
          echo -e "${C_DIM}ℹ ACP session is already tracked ('${acp_tracked}'). Saving untracked CLI session.${C_RESET}"
          source_type="cli"
          source_ref="$cli_ref"
        elif [[ -n "$cli_tracked" && -n "$acp_tracked" ]]; then
          echo -e "${C_YELLOW}ℹ Both sessions are already tracked (CLI: '${cli_tracked}', ACP: '${acp_tracked}').${C_RESET}"
          return 0
        else
          echo -e "${C_YELLOW}ℹ Both CLI and ACP have differing untracked sessions. Saving CLI by default (use --acp to save ACP).${C_RESET}"
          source_type="cli"
          source_ref="$cli_ref"
        fi
      fi
    fi
  fi

  while [[ -z "$new_name" ]]; do
    read -p "Profile name (e.g. work, personal): " -r new_name || return 1
    new_name=$(printf '%s' "$new_name" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  done

  if [[ ! "$new_name" =~ ^[a-z0-9_-]+$ ]]; then
    echo -e "${C_RED}Error: invalid name '$new_name'. Use alphanumeric characters, hyphens, or underscores.${C_RESET}" >&2
    return 1
  fi

  local dest_file="$AUTH_DIR/antigravity-oauth-token-$new_name"
  if [[ -f "$dest_file" ]]; then
    echo -e "${C_RED}Error: profile '$new_name' already exists at $dest_file${C_RESET}" >&2
    return 1
  fi

  if [[ "$source_type" == "cli" ]]; then
    cp -p "$TARGET_AUTH" "$dest_file"
    chmod 600 "$dest_file"
  else
    cat << EOF > "$dest_file"
{
  "auth_method": "consumer",
  "token": {
    "access_token": "",
    "token_type": "Bearer",
    "refresh_token": "$source_ref",
    "expiry": ""
  }
}
EOF
    chmod 600 "$dest_file"
    if [[ ! -f "$TARGET_AUTH" ]]; then
      cp -p "$dest_file" "$TARGET_AUTH"
      chmod 600 "$TARGET_AUTH"
    fi
  fi

  write_acp_token "$source_ref" "$dest_file"
  reload_acp_daemons "$new_name"
  echo -e "${C_GREEN}✔ Saved active session as '${C_BOLD}${new_name}${C_RESET}${C_GREEN}' (CLI & ACP).${C_RESET}"
  sync_AUTHs_bg
}

sync_AUTHs() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo -e "${C_YELLOW}ℹ Python 3 not detected; skipping live quota refresh.${C_RESET}" >&2
    return 0
  fi
  AUTH_DIR="$AUTH_DIR" USAGE_FILE="$USAGE_FILE" DEFAULT_QUOTA="$DEFAULT_QUOTA" REFRESH="$REFRESH" python3 - << 'PYEOF'
import json, glob, urllib.request, urllib.parse, time, os, codecs
from datetime import datetime, timezone
from concurrent.futures import ThreadPoolExecutor

client_id = codecs.decode('1071006060591-gzuffva2u21yper235igbybwu4t403rc.nccf.tbbtyrhfrepbagrag.pbz', 'rot_13')
client_secret = codecs.decode('TBPFCK-X58SJE486YqYW1zYO8fKP4m6dQNs', 'rot_13')
auth_dir = os.environ.get('AUTH_DIR', os.path.expanduser('~/.agy_toys/auth'))
usage_file = os.environ.get('USAGE_FILE', os.path.join(auth_dir, 'auth_usage.csv'))
default_quota = os.environ.get('DEFAULT_QUOTA', '100')
default_refresh = os.environ.get('REFRESH', '7d')

def parse_iso(ts_str):
    if not ts_str: return 0
    try:
        dt = datetime.fromisoformat(ts_str.replace('Z', '+00:00'))
        return int(dt.timestamp())
    except: return 0

def fetch_single_auth(fpath):
    try:
        os.chmod(fpath, 0o600)
    except Exception:
        pass
    name = os.path.basename(fpath).replace('antigravity-oauth-token-', '')
    try:
        with open(fpath, 'r') as f:
            data = json.load(f)
    except Exception:
        return name, None

    token_obj = data.get('token', {})
    access_token = token_obj.get('access_token') or data.get('access_token')
    refresh_token = token_obj.get('refresh_token') or data.get('refresh_token')

    def call_api(at):
        headers = {'Authorization': f'Bearer {at}', 'Content-Type': 'application/json', 'User-Agent': 'antigravity-cli'}
        req = urllib.request.Request(
            'https://cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels',
            data=b'{}',
            headers=headers,
            method='POST'
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            return json.loads(resp.read().decode())

    res = None
    if access_token:
        try:
            res = call_api(access_token)
        except Exception:
            pass

    if not res and refresh_token:
        body = urllib.parse.urlencode({
            'client_id': client_id,
            'client_secret': client_secret,
            'grant_type': 'refresh_token',
            'refresh_token': refresh_token,
        }).encode()
        rreq = urllib.request.Request('https://oauth2.googleapis.com/token', data=body, method='POST')
        try:
            with urllib.request.urlopen(rreq, timeout=6) as rresp:
                rres = json.loads(rresp.read().decode())
                new_at = rres.get('access_token')
                if new_at:
                    access_token = new_at
                    if 'token' in data and isinstance(data['token'], dict):
                        data['token']['access_token'] = new_at
                        exp_dt = datetime.fromtimestamp(time.time() + rres.get('expires_in', 3600), timezone.utc)
                        data['token']['expiry'] = exp_dt.strftime('%Y-%m-%dT%H:%M:%S.%fZ')
                    else:
                        data['access_token'] = new_at
                    try:
                        with open(fpath, 'w') as out_f:
                            json.dump(data, out_f, indent=2)
                        os.chmod(fpath, 0o600)
                    except Exception:
                        pass
                    res = call_api(access_token)
        except Exception:
            pass

    if not res:
        return name, None

    models = res.get('models', {})
    gem_rem = 1.0; gem_reset = 0
    claude_rem = 1.0; claude_reset = 0
    for mid, mcfg in models.items():
        qinfo = mcfg.get('quotaInfo', {})
        rf = qinfo.get('remainingFraction', 1.0)
        rt = parse_iso(qinfo.get('resetTime'))
        if 'gemini' in mid:
            gem_rem = min(gem_rem, rf)
            if rt > gem_reset: gem_reset = rt
        elif 'claude' in mid:
            claude_rem = min(claude_rem, rf)
            if rt > claude_reset: claude_reset = rt    return name, {'gem_rem': gem_rem, 'gem_reset': gem_reset, 'claude_rem': claude_rem, 'claude_reset': claude_reset}

existing = {}
if os.path.exists(usage_file):
    with open(usage_file, 'r') as f:
        for line in f:
            p = line.strip().split(',')
            if p and p[0]: existing[p[0]] = p

files = sorted(glob.glob(os.path.join(auth_dir, 'antigravity-oauth-token-*')))
with ThreadPoolExecutor(max_workers=max(1, len(files))) as pool:
    fetched = dict(pool.map(fetch_single_auth, files))

out_lines = []
now = int(time.time())
for fpath in files:
    name = os.path.basename(fpath).replace('antigravity-oauth-token-', '')
    orig = existing.get(name, [name, default_quota, default_refresh, '0', '0', default_quota, default_refresh, '0', '0'])
    while len(orig) < 9: orig.append('0')
    qG, rG = orig[1] or default_quota, orig[2] or default_refresh
    qC, rC = orig[5] or default_quota, orig[6] or default_refresh
    uG, lG = orig[3] or '0', orig[4] or '0'
    uC, lC = orig[7] or '0', orig[8] or '0'

    q = fetched.get(name)
    if q is not None:
        uG = str(int(round((1.0 - q['gem_rem']) * int(qG))))
        if q['gem_reset'] > now and int(uG) > 0:
            lG = str(q['gem_reset'] - 604800)
        else:
            lG = '0'

        uC = str(int(round((1.0 - q['claude_rem']) * int(qC))))
        if q['claude_reset'] > now and int(uC) > 0:
            lC = str(q['claude_reset'] - 604800)
        else:
            lC = '0'
    else:
        uG = qG; lG = '9999999999'
        uC = qC; lC = '9999999999'

    out_lines.append(f"{name},{qG},{rG},{uG},{lG},{qC},{rC},{uC},{lC}\n")

tmp_usage = usage_file + '.tmp'
with open(tmp_usage, 'w') as f:
    f.writelines(out_lines)
os.replace(tmp_usage, usage_file)
PYEOF

  # Keep active CLI and ACP token files in sync if active profile was refreshed
  local active_name
  active_name=$(find_active_AUTH 2>/dev/null || true)
  if [[ -n "$active_name" ]]; then
    local active_f="${AUTH_DIR}/antigravity-oauth-token-${active_name}"
    if [[ -f "$active_f" && -f "$TARGET_AUTH" ]]; then
      local active_rf cur_cli_rf
      active_rf=$(get_refresh_AUTH "$active_f" 2>/dev/null || true)
      cur_cli_rf=$(get_refresh_AUTH "$TARGET_AUTH" 2>/dev/null || true)
      if [[ -n "$active_rf" && "$active_rf" == "$cur_cli_rf" ]]; then
        cp -p "$active_f" "$TARGET_AUTH" 2>/dev/null || true
        chmod 600 "$TARGET_AUTH" 2>/dev/null || true
      fi
    fi
  fi
  sync_t3_profiles
}

sync_AUTHs_bg() {
  local sync_lock="$AUTH_DIR/.sync_lock"
  if [[ -f "$sync_lock" ]]; then
    local lock_pid
    lock_pid=$(cat "$sync_lock" 2>/dev/null || true)
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$sync_lock" 2>/dev/null || true
  fi
  (
    echo "$$" > "$sync_lock" 2>/dev/null || true
    trap 'rm -f "$sync_lock" 2>/dev/null || true' EXIT
    sync_AUTHs >/dev/null 2>&1
  ) &
  disown 2>/dev/null || true
}

prompt_stop_agy() {
  local action_desc="${1:-proceed}"
  if pgrep -x "agy" >/dev/null 2>&1; then
    local answer
    read -p "Would you like to stop 'agy' and ${action_desc}? (y/N): " -r answer || answer="n"
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      echo -e "${C_DIM}Stopping 'agy' process(es)...${C_RESET}"
      kill $(pgrep -x agy) 2>/dev/null || true
      sleep 1
      if pgrep -x "agy" >/dev/null 2>&1; then
        echo -e "${C_YELLOW}Warning: Some 'agy' process(es) did not stop. Attempting force kill...${C_RESET}"
        kill -9 $(pgrep -x agy) 2>/dev/null || true
        sleep 0.5
      fi
    else
      echo -e "${C_RED}Error: Cannot ${action_desc} while 'agy' is running on the system.${C_RESET}" >&2
      return 1
    fi
  fi
  return 0
}

clean_cli() {
  local target="all"
  local force=0
  for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--force" ]]; then
      force=1
    elif [[ -n "$arg" ]]; then
      target="$arg"
    fi
  done

  if (( force == 0 )); then
    prompt_stop_agy "proceed with cleanup" || return 1
  fi

  local cli_dir="$HOME/.gemini/antigravity-cli"
  echo -e "${C_BOLD}${C_CYAN}🧹 Cleaning CLI data: ${C_WHITE}${target}${C_RESET}"
  
  case "$target" in
    chats|conversations)
      echo -e "${C_DIM}Cleaning conversations, logs, and caches...${C_RESET}"
      rm -rf "$cli_dir"/{conversations,brain,log,cache,crashes,implicit}/* "$cli_dir"/{conversation_summaries.db*,history.jsonl*,cli.log*} 2>/dev/null || true
      echo -e "${C_GREEN}✔ Cleared conversations, logs, and caches.${C_RESET}"
      ;;
    permissions)
      echo -e "${C_DIM}Resetting trusted workspace permissions...${C_RESET}"
      if command -v jq >/dev/null 2>&1 && [[ -f "$cli_dir/settings.json" ]]; then
        local tmp_settings
        tmp_settings=$(mktemp)
        jq '.trustedWorkspaces = []' "$cli_dir/settings.json" > "$tmp_settings" 2>/dev/null && mv "$tmp_settings" "$cli_dir/settings.json" || rm -f "$tmp_settings"
      fi
      echo -e "${C_GREEN}✔ Workspace permissions reset.${C_RESET}"
      ;;
    acp)
      echo -e "${C_DIM}Cleaning ACP conversations and databases...${C_RESET}"
      local acp_dir
      acp_dir="$(dirname "$TARGET_ACP_AUTH")"
      rm -rf "$acp_dir"/conversations/* 2>/dev/null || true
      local t3_base="$T3_USERDATA_DIR/providers/antigravity"
      if [[ -d "$t3_base" ]]; then
        for t3_inst in "$t3_base"/*; do
          rm -rf "$t3_inst/antigravity-acp/conversations"/* 2>/dev/null || true
        done
      fi
      echo -e "${C_GREEN}✔ Cleared ACP conversations.${C_RESET}"
      ;;
    all)
      clean_cli chats -f
      clean_cli permissions -f
      clean_cli acp -f
      ;;
    *)
      echo -e "${C_RED}Error: invalid clean target '$target'. Options: chats, permissions, acp, all${C_RESET}" >&2
      return 1
      ;;
  esac
}

sync_skills() {
  local cli_dir="$HOME/.gemini/antigravity-cli"
  local agents_skills="$HOME/.agents/skills"
  echo -e "${C_BOLD}${C_CYAN}🔄 Syncing skills with ${C_WHITE}${agents_skills}${C_RESET}"
  
  mkdir -p "$agents_skills"
  mkdir -p "$cli_dir"

  if [[ -L "$cli_dir/skills" ]]; then
    local current_target
    current_target=$(readlink "$cli_dir/skills")
    if [[ "$current_target" == "$agents_skills" || "$current_target" == "$agents_skills/" ]]; then
      echo -e "${C_GREEN}✔ Skills directory is already linked to $agents_skills.${C_RESET}"
      prompt_stop_agy "restart 'agy' to apply synced skills" || true
      return 0
    fi
    rm -f "$cli_dir/skills"
  elif [[ -d "$cli_dir/skills" ]]; then
    echo -e "${C_DIM}Copying skills to $agents_skills...${C_RESET}"
    cp -rn "$cli_dir/skills/"* "$agents_skills/" 2>/dev/null || true
    rm -rf "$cli_dir/skills"
  fi

  ln -s "$agents_skills" "$cli_dir/skills"
  echo -e "${C_GREEN}✔ Linked CLI skills to $agents_skills.${C_RESET}"
  prompt_stop_agy "restart 'agy' to apply synced skills" || true
}

YOLO_FILE="$AUTH_DIR/.yolo"

cmd_yolo() {
  local action="${1:-toggle}"
  case "$action" in
    true)
      touch "$YOLO_FILE"
      echo -e "${C_BOLD}${C_GREEN}✔ YOLO mode enabled${C_RESET} ${C_DIM}(--dangerously-skip-permissions active by default)${C_RESET}"
      ;;
    false)
      rm -f "$YOLO_FILE"
      echo -e "${C_BOLD}${C_YELLOW}✔ YOLO mode disabled${C_RESET} ${C_DIM}(interactive permission prompts active)${C_RESET}"
      ;;
    status)
      if [[ -f "$YOLO_FILE" ]]; then
        echo -e "${C_BOLD}${C_GREEN}YOLO mode: ON${C_RESET} ${C_DIM}(--dangerously-skip-permissions active by default)${C_RESET}"
      else
        echo -e "${C_BOLD}${C_YELLOW}YOLO mode: OFF${C_RESET} ${C_DIM}(interactive permission prompts active)${C_RESET}"
      fi
      ;;
    *)
      if [[ -f "$YOLO_FILE" ]]; then
        cmd_yolo false
      else
        cmd_yolo true
      fi
      ;;
  esac
}

