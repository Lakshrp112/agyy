    lock_pid=$(cat "$sync_lock" 2>/dev/null || true)
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$sync_lock" 2>/dev/null || true
  fi
  (
    echo "$$" > "$sync_lock" 2>/dev/null || true
    trap 'rm -f "$sync_lock" 2>/dev/null || true' EXIT
    sync_AUTHs >/dev/null 2>&1
  ) &
  disown 2>/dev/null || true
}

prompt_stop_agy() {
  local action_desc="${1:-proceed}"
  if pgrep -x "agy" >/dev/null 2>&1; then
    local answer
    read -p "Would you like to stop 'agy' and ${action_desc}? (y/N): " -r answer || answer="n"
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      echo -e "${C_DIM}Stopping 'agy' process(es)...${C_RESET}"
      pkill -x "agy" 2>/dev/null || true
      sleep 1
      if pgrep -x "agy" >/dev/null 2>&1; then
        echo -e "${C_YELLOW}Warning: Some 'agy' process(es) did not stop. Attempting force kill...${C_RESET}"
        pkill -9 -x "agy" 2>/dev/null || true
        sleep 0.5
      fi
    else
      echo -e "${C_RED}Error: Cannot ${action_desc} while 'agy' is running on the system.${C_RESET}" >&2
      return 1
    fi
  fi
  return 0
}

